<div class="kito-container kito-newsletter-wrap">
  {% for block in section.blocks %}
    <section class="kito-newsletter" id="contact" {{ block.shopify_attributes }}>
      <p class="kito-logo">{{ block.settings.logo_text }}</p>
      <p class="kito-newsletter-promo">{{ block.settings.text }}</p>
      {% form 'customer', class: 'kito-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="KitoEmail-{{ section.id }}">Email address</label>
        <span class="kito-newsletter-field"><span class="fa fa-envelope-o" aria-hidden="true"></span><input id="KitoEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ block.settings.placeholder }}" required></span>
        <button class="kito-button" type="submit">{{ block.settings.button_label }}</button>
      {% endform %}
    </section>
  {% endfor %}
</div>

{% schema %}
{
  "name": "KITO newsletter",
  "max_blocks": 1,
  "blocks": [{ "type": "newsletter", "name": "Newsletter content", "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "KITO" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join our list and get 20% off your first purchase!" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ]}],
  "presets": [{ "name": "KITO newsletter", "blocks": [{ "type": "newsletter" }] }]
}
{% endschema %}
