          data-discount-prefix="minus"
          data-discount-off-label="{{ 'sections.omnise-3003eed577a12a4dc391cfef.omnise_2ctr' | t }}"
          data-discount-save-label="{{ 'sections.omnise-3003eed577a12a4dc391cfef.omnise_1j2ql' | t }}"
          data-bnode="omnise-nwnuoc" data-bnode-index="1"
        >
          {% if compare_at_price %}
            {% assign discount = compare_at_price
              | minus: price
              | times: 100.0
              | divided_by: compare_at_price
            %}
            {% assign discount = discount | round: 2 %}
          {% else %}
            {% assign discount = 0 %}
          {% endif %}
          {% assign discount_value = discount | round %}

          
            {{ 'sections.omnise-3003eed577a12a4dc391cfef.omnise_1j2hz' | t }}
          
        </div>

      {% else %}
        <div
          class="omnise-product-badge omnise-badge-empty omnise-live-product omnise-p2"
          data-bnode="omnise-nwnuoc" data-bnode-index="1"
        >
         
        </div>
      {% endif %}
    {% endunless %}
  </div></div></div></div>
    
    
    
    
    <h3 class="omnise-product-title omnise-h5" data-bnode="omnise-uq849q" data-bnode-index="2">
      <a href="{{ product.url }}">
        {{ product.title }}
      </a>
    </h3>
    
    
        <div class="omnise-product-price-wrapper {% if product.compare_at_price > product.price %} omnise-on-sale {% endif %} omnise-p2" data-bnode="omnise-ky6rhi" data-bnode-index="3">
          <span class="omnise-product-price omnise-price-sale">
            {{ product.price | money_with_currency | strip_html | escape }}
          </span>
          <span class="omnise-product-price-compare" {% unless product.compare_at_price > product.price %} style="display:none;"  {% endunless %}>
            {{ product.compare_at_price | money_with_currency | strip_html | escape }}
          </span>
        </div>
    
  

  {% if product.variants.size > 0 and product.has_only_default_variant == false %}
  <div class="omnise-variant-box" data-omnise-size-chart-root data-size-chart-modal-id="omnise-size-chart-modal-{{ product.id }}-{{ section.id }}" data-bnode="omnise-9akq2u" data-bnode-index="4">
    {% assign omnise_size_chart_page = blank %}
    

    {% for option in product.options_with_values %}
      {% assign opt_name_handle = option.name | downcase | strip %}
      {% assign skip_option = false %}
      

      {% unless skip_option %}
        <div class="omnise-option" data-option-index="{{ forloop.index0 }}">
          
          

          
            <div class="omnise-swatch omnise-p">
              {% for value in option.values %}
                {% assign avai = false %}
                {% assign v_img = "" %}
                
                {% for v in product.variants %}
                  {% if v.options contains value %}
                    {% if v.available %}{% assign avai = true %}{% endif %}
                    {% if v.featured_image != blank %}
                      {% assign v_img = v.featured_image | img_url: '300x' %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% assign is_color = false %}
                {% if opt_name_handle == "color" %}
                  {% assign is_color = true %}
                {% endif %}

                {% assign is_image = false %}
                {% if opt_name_handle == "color" and "color" == "image" %}
                  {% assign is_image = true %}
                {% endif %}

                {% assign is_image_display = false %}
                {% if is_image and v_img != blank %}
                  {% assign is_image_display = true %}
                {% endif %}

                {% assign is_color_fallback = false %}
                {% if is_image and v_img == blank %}
                  {% assign is_color_fallback = true %}
                {% endif %}

                <label 
                  class="omnise-radio-wrap {% if is_color and "color" == "color" or is_color_fallback %}omnise-swatch-color{% endif %}{% if is_image_display %} omnise-swatch-image{% endif %} {% unless avai %}omnise-variant-disabled{% endunless %}"
                  data-src-image="{{ v_img }}"
                  {% if is_color and "color" == "color" or is_color_fallback %}
                    style="background-color: {{ value.swatch.color | default: '#eeeeee' }};"
                  {% elsif is_image_display %}
                    style="background-image: url('{{ v_img }}');"
                  {% endif %}
                >
                  <input type="radio" 
                        name="option{{ option.position }}-{{ product.id }}-{{ section.id }}" 
                        value="{{ value | escape }}" 
                        class="omnise-radio"
                        {% if option.selected_value == value %}checked{% endif %}
                        {% unless avai %}disabled{% endunless %}
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-src-image="{{ v_img }}">
                  <span class="omnise-radio-lb">{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          

        </div>
      {% endunless %}
    {% endfor %}

    
    {% unless collection %}
    <select name="id" class="omnise-option-selector" style="display:none;" data-omnise-variant-select>
      {% for variant in product.variants %}
        <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
          {{ variant.title }}
        </option>
      {% endfor %}
    </select>
     {% endunless collection %}
   
  </div>
  {% endif %}
    </div></div></div>
       {% endfor %}
       {% else %}
         <div class="omnise-content-list-empty">No related products found</div>
       {% endif %}
