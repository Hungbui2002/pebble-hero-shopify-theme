  .helix-mega-product__media img,
  .helix-mega-product__media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .helix-mega-product__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 7px;
    color: #fff;
    background: #e72020;
    border-radius: 999px;
    font-size: 11px;
  }

  .helix-mega-product__content {
    display: grid;
    gap: 5px;
    padding-top: 9px;
  }

  .helix-mega-product__content > a {
