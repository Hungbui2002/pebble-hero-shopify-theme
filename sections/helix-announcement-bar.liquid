{%- if section.blocks.size > 0 -%}
  <helix-announcement
    class="helix-announcement"
    data-autoplay="{{ section.settings.autoplay | times: 1000 }}"
    style="--helix-announcement-bg: {{ section.settings.background }}; --helix-announcement-text: {{ section.settings.text_color }};"
    aria-label="{{ 'sections.helix_header.announcement' | t }}"
  >
    <div class="helix-announcement__inner">
      <button class="helix-announcement__control" type="button" data-announcement-previous aria-label="{{ 'sections.helix_header.previous_announcement' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="helix-announcement__viewport" aria-live="polite">
        {%- for block in section.blocks -%}
          <div class="helix-announcement__slide{% if forloop.first %} is-active{% endif %}" data-announcement-slide data-index="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <button class="helix-announcement__control" type="button" data-announcement-next aria-label="{{ 'sections.helix_header.next_announcement' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </helix-announcement>
{%- endif -%}

{% stylesheet %}
  .helix-announcement {
    position: relative;
    z-index: 60;
    display: block;
    height: 38.4px;
    overflow: hidden;
    color: var(--helix-announcement-text);
    background: var(--helix-announcement-bg);
    font-family: var(--theme-body-font, inherit);
    font-size: 14px;
    line-height: 1.2;
  }

  .helix-announcement__inner {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 32px;
    align-items: center;
    width: min(100%, 764px);
    height: 100%;
    margin-inline: auto;
    padding-inline: 8px;
  }

  .helix-announcement__viewport {
    position: relative;
    min-width: 0;
    height: 100%;
    overflow: hidden;
  }

  .helix-announcement__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 8px;
    opacity: 0;
    transform: translateY(10px);
    visibility: hidden;
    transition: opacity 300ms ease, transform 300ms ease, visibility 0s linear 300ms;
  }

  .helix-announcement__slide.is-active {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }

  .helix-announcement__slide > * {
    max-width: 700px;
    overflow: hidden;
    color: inherit;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .helix-announcement__slide a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .helix-announcement__control {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    border-radius: 50%;
    cursor: pointer;
  }

  .helix-announcement__control svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .helix-announcement__control:focus-visible,
  .helix-announcement__slide a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .helix-announcement:has(.helix-announcement__slide:only-child) .helix-announcement__control {
    visibility: hidden;
  }

  @media (max-width: 520px) {
    .helix-announcement__inner {
      padding-inline: 2px;
    }

    .helix-announcement__slide {
      padding-inline: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .helix-announcement__slide {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('helix-announcement')) {
    customElements.define('helix-announcement', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;
        this.slides = Array.from(this.querySelectorAll('[data-announcement-slide]'));
        this.index = Math.max(0, this.slides.findIndex((slide) => slide.classList.contains('is-active')));
        this.delay = Number(this.dataset.autoplay || 0);
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.querySelector('[data-announcement-previous]')?.addEventListener('click', () => this.show(this.index - 1, true));
        this.querySelector('[data-announcement-next]')?.addEventListener('click', () => this.show(this.index + 1, true));
        this.addEventListener('pointerenter', () => this.stop());
        this.addEventListener('pointerleave', () => this.start());
        this.addEventListener('focusin', () => this.stop());
        this.addEventListener('focusout', (event) => {
          if (!this.contains(event.relatedTarget)) this.start();
        });
        document.addEventListener('shopify:block:select', (event) => {
          if (!this.contains(event.target)) return;
          const slide = event.target.closest('[data-announcement-slide]');
          if (slide) this.show(Number(slide.dataset.index), false);
          this.stop();
        });
        document.addEventListener('shopify:block:deselect', () => this.start());
        this.show(this.index, false);
        this.start();
      }

      disconnectedCallback() {
        this.stop();
      }

      show(nextIndex, restart) {
        if (!this.slides.length) return;
        this.index = (nextIndex + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, index) => {
          const active = index === this.index;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', String(!active));
          slide.inert = !active;
        });
        if (restart) {
          this.stop();
          this.start();
        }
      }

      start() {
        if (this.slides.length < 2 || this.delay < 1000 || this.reducedMotion || this.timer) return;
        this.timer = window.setInterval(() => this.show(this.index + 1, false), this.delay);
      }

      stop() {
        window.clearInterval(this.timer);
        this.timer = null;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Helix announcement bar",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#D3F285" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#202020" },
    { "type": "range", "id": "autoplay", "label": "Autoplay interval", "min": 0, "max": 10, "step": 1, "unit": "s", "default": 5, "info": "Set to 0 to disable autoplay." }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Free shipping for all orders" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Helix announcement bar",
      "blocks": [
        { "type": "announcement" },
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
