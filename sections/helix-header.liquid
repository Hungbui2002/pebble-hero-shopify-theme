  .helix-mega__product-controls .helix-icon {
    width: 17px;
    height: 17px;
  }

  .helix-mega__products {
    display: flex;
    gap: 10px;
    padding-bottom: 6px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
