{% assign figma_story_image_one = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-story-one.jpg?v=1784607869' %}
{% assign figma_story_image_two = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-story-three.jpg?v=1784607885' %}
<div class="kito-container kito-story-wrap">
  <section class="kito-story">
    {% for block in section.blocks %}
      {% if block.type == 'story_image_one' %}<div class="kito-story-image" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}{% else %}<img src="{{ figma_story_image_one }}" width="800" height="800" loading="lazy" alt="KITO toy detail">{% endif %}</div>{% endif %}
      {% if block.type == 'story_image_two' %}<div class="kito-story-image" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt }}{% else %}<img src="{{ figma_story_image_two }}" width="800" height="800" loading="lazy" alt="Child playing with a KITO toy">{% endif %}</div>{% endif %}
      {% if block.type == 'story_content' %}<div class="kito-story-copy" {{ block.shopify_attributes }}><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p><a class="kito-button" href="{{ block.settings.button_link | default: '#contact' }}">{{ block.settings.button_label }}</a></div>{% endif %}
    {% endfor %}
  </section>
</div>

{% schema %}
{
  "name": "KITO story",
  "max_blocks": 3,
  "blocks": [
    { "type": "story_image_one", "name": "Story image 1", "settings": [
    { "type": "image_picker", "id": "image", "label": "First image" }
    ]},
    { "type": "story_image_two", "name": "Story image 2", "settings": [
    { "type": "image_picker", "id": "image", "label": "Second image" }
    ]},
    { "type": "story_content", "name": "Story content", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Big Love For Our Lovely Kids." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. Ut enim ad minim veniam, quis nostrud exercitation." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "Button link" }
    ]}
  ],
  "presets": [{ "name": "KITO story", "blocks": [{ "type": "story_image_one" }, { "type": "story_image_two" }, { "type": "story_content" }] }]
}
{% endschema %}
