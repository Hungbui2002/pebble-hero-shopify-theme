{% assign figma_icon_search = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-icon-search.png?v=1784614556' %}
{% assign figma_icon_bag = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-icon-bag.png?v=1784614569' %}
{% assign figma_icon_heart = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-icon-heart.png?v=1784614600' %}
{% assign figma_story_image_one = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-story-one.jpg?v=1784607869' %}
{% assign figma_story_image_two = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-story-three.jpg?v=1784607885' %}
{% assign figma_team_image_one = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-team-christian.jpg?v=1784607809' %}
{% assign figma_team_image_two = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-team-diana.jpg?v=1784607818' %}
{% assign figma_team_image_three = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-team-joey.jpg?v=1784607828' %}
{% assign figma_team_image_four = 'https://cdn.shopify.com/s/files/1/0947/1528/1780/files/kito-team-behrouz.jpg?v=1784607837' %}

{% if false %}<main class="kito-home" id="KitoHome-{{ section.id }}">
  <div class="kito-topbar"><span>KITO - Every day low price</span><strong>Free Delivery on orders over £120. Don’t miss discount.</strong><span>ENG&nbsp;&nbsp; | &nbsp;&nbsp;USD</span></div>
  <header class="kito-header">
    <a class="kito-logo" href="{{ routes.root_url }}">{{ section.settings.logo_text }}</a>
    <button class="kito-menu-toggle" type="button" aria-expanded="false" aria-controls="KitoNav-{{ section.id }}">
      <span></span><span></span><span></span>
      <span class="visually-hidden">Open menu</span>
    </button>
    <nav class="kito-nav" id="KitoNav-{{ section.id }}" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.root_url }}">Home</a>
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="#pages">Pages</a>
        <a href="#contact">Contact</a>
      {% endif %}
    </nav>
    {% comment %}<div class="kito-actions" aria-label="Store actions">
      <a href="{{ routes.search_url }}" aria-label="Search">⌕</a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">🛒</a>
      <a href="{{ routes.account_url }}" aria-label="Account">◉</a>
    </div>{% endcomment %}
    <div class="kito-actions" aria-label="Store actions">
      <a href="{{ routes.search_url }}" aria-label="Search"><img src="{{ figma_icon_search }}" width="25" height="25" alt=""></a>
      <a href="{{ routes.cart_url }}" aria-label="Cart"><img src="{{ figma_icon_bag }}" width="25" height="25" alt=""><span class="kito-action-count">0</span></a>
      <a href="{{ routes.root_url }}#wishlist" aria-label="Wishlist"><img src="{{ figma_icon_heart }}" width="25" height="25" alt=""><span class="kito-action-count">0</span></a>
    </div>
  </header>

  <div class="kito-container">
    <div class="kito-page-intro">
      <h1>{{ section.settings.page_title }}</h1>
      <p>{{ section.settings.breadcrumb_text }}</p>
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'hero' %}
        <section class="kito-hero" id="about" {{ block.shopify_attributes }}>
          <div class="kito-hero-copy"><p class="kito-eyebrow">{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2>{% if block.settings.button_label != blank %}<a class="kito-button" href="{{ block.settings.button_link | default: '#contact' }}">{{ block.settings.button_label }}</a>{% endif %}</div>
          <div class="kito-media kito-hero-media">{% if block.settings.video != blank %}{{ block.settings.video | video_tag: controls: true, autoplay: false, loop: false, muted: false, image_size: '1200x' }}{% elsif block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: block.settings.image.alt }}{% else %}<div class="kito-hero-art"><img src="{{ 'kito-hero-figma.png' | asset_url }}" width="705" height="600" loading="eager" alt="Blue bird plush toy in a basket"><span class="kito-play" aria-hidden="true">▶</span></div>{% endif %}</div>
        </section>
      {% endif %}
    {% endfor %}
    {% assign headings = section.blocks | where: 'type', 'section_heading' %}
    {% assign stats_heading = headings | first %}
    {% assign team_heading = headings | last %}
    {% if stats_heading %}<div class="kito-section-heading kito-stats-heading" {{ stats_heading.shopify_attributes }}><h2>{{ stats_heading.settings.heading }}</h2></div>{% endif %}
    <section class="kito-stats">
      {% for block in section.blocks %}{% if block.type == 'stat' %}<article class="kito-card kito-stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><h3>{{ block.settings.label }}</h3><p>{{ block.settings.description }}</p></article>{% endif %}{% endfor %}
    </section>
    {% for block in section.blocks %}
      {% if block.type == 'story' %}
        <section class="kito-story" {{ block.shopify_attributes }}><div class="kito-story-image">{% if block.settings.image_one != blank %}{{ block.settings.image_one | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image_one.alt }}{% else %}<img src="{{ figma_story_image_one }}" width="800" height="800" loading="lazy" alt="KITO toy detail">{% endif %}</div><div class="kito-story-image">{% if block.settings.image_two != blank %}{{ block.settings.image_two | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image_two.alt }}{% else %}<img src="{{ figma_story_image_two }}" width="800" height="800" loading="lazy" alt="Child playing with a KITO toy">{% endif %}</div><div class="kito-story-copy"><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.text }}</p><a class="kito-button" href="{{ block.settings.button_link | default: '#contact' }}">{{ block.settings.button_label }}</a></div></section>
      {% endif %}
    {% endfor %}
    {% if team_heading %}<div class="kito-section-heading kito-team-heading" {{ team_heading.shopify_attributes }}><h2>{{ team_heading.settings.heading }}</h2></div>{% endif %}
    <section class="kito-team">
      {% comment %}
      {% for block in section.blocks %}{% if block.type == 'team_member' %}<article class="kito-card kito-person" {{ block.shopify_attributes }}><div class="kito-avatar">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.name }}{% else %}<img src="{{ figma_team_image }}" loading="lazy" alt="{{ block.settings.name }}">{% endif %}</div><h3>{{ block.settings.name }}</h3><p class="kito-role">{{ block.settings.role }}</p><p>{{ block.settings.description }}</p><div class="kito-socials">{% if block.settings.facebook != blank %}<a href="{{ block.settings.facebook }}" aria-label="Facebook">f</a>{% endif %}{% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" aria-label="Instagram">◎</a>{% endif %}{% if block.settings.linkedin != blank %}<a href="{{ block.settings.linkedin }}" aria-label="LinkedIn">in</a>{% endif %}</div></article>{% endif %}{% endfor %}
      {% endcomment %}
      {% comment %}
      {% for block in section.blocks %}{% if block.type == 'team_member' %}<article class="kito-card kito-person" {{ block.shopify_attributes }}><div class="kito-avatar"><img src="{{ figma_team_image }}" width="240" height="240" loading="lazy" alt="{{ block.settings.name }}"></div><h3>{{ block.settings.name }}</h3><p class="kito-role">{{ block.settings.role }}</p><p>{{ block.settings.description }}</p><div class="kito-socials">{% if block.settings.facebook != blank %}<a href="{{ block.settings.facebook }}" aria-label="Facebook">f</a>{% endif %}{% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" aria-label="Instagram">◎</a>{% endif %}{% if block.settings.linkedin != blank %}<a href="{{ block.settings.linkedin }}" aria-label="LinkedIn">in</a>{% endif %}</div></article>{% endif %}{% endfor %}
      {% endcomment %}
      {% assign team_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'team_member' %}
          {% assign team_count = team_count | plus: 1 %}
          {% assign team_image = figma_team_image_one %}
          {% if team_count == 2 %}{% assign team_image = figma_team_image_two %}{% elsif team_count == 3 %}{% assign team_image = figma_team_image_three %}{% elsif team_count >= 4 %}{% assign team_image = figma_team_image_four %}{% endif %}
          <article class="kito-card kito-person" {{ block.shopify_attributes }}><div class="kito-avatar">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.name }}{% else %}<img src="{{ team_image }}" width="240" height="240" loading="lazy" alt="{{ block.settings.name }}">{% endif %}</div><h3>{{ block.settings.name }}</h3><p class="kito-role">{{ block.settings.role }}</p><p>{{ block.settings.description }}</p><div class="kito-socials">{% if block.settings.facebook != blank %}<a href="{{ block.settings.facebook }}" aria-label="Facebook">f</a>{% endif %}{% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" aria-label="Instagram">◎</a>{% endif %}{% if block.settings.linkedin != blank %}<a href="{{ block.settings.linkedin }}" aria-label="LinkedIn">in</a>{% endif %}</div></article>
        {% endif %}
      {% endfor %}
    </section>
    <section class="kito-benefits">
      {% for block in section.blocks %}{% if block.type == 'benefit' %}<article class="kito-benefit" {{ block.shopify_attributes }}><span class="kito-benefit-icon">{{ block.settings.icon }}</span><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></div></article>{% endif %}{% endfor %}
    </section>
    {% for block in section.blocks %}
      {% if block.type == 'newsletter' %}
        <section class="kito-newsletter" id="contact" {{ block.shopify_attributes }}><p class="kito-logo">{{ block.settings.logo_text }}</p><p class="kito-newsletter-promo">{{ block.settings.text }}</p>{% form 'customer', class: 'kito-newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="KitoEmail-{{ section.id }}">Email address</label><input id="KitoEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ block.settings.placeholder }}" required><button class="kito-button" type="submit">{{ block.settings.button_label }}</button>{% endform %}</section>
      {% endif %}
    {% endfor %}

    <footer class="kito-footer">
      <div class="kito-footer-contact"><p class="kito-logo">{{ section.settings.logo_text }}</p><h3>Contact info</h3><p>{{ section.settings.contact_address }}</p><p>{{ section.settings.contact_email }}</p><p>{{ section.settings.contact_phone }}</p></div>
      <div><h3>{{ section.settings.footer_column_one_title }}</h3>{% if section.settings.footer_menu_one != blank %}{% for link in section.settings.footer_menu_one.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="{{ routes.account_url }}">My account</a><a href="{{ routes.cart_url }}">Cart</a><a href="#wishlist">Wishlist</a><a href="#compare">Product Compare</a>{% endif %}</div>
      <div><h3>{{ section.settings.footer_column_two_title }}</h3>{% if section.settings.footer_menu_two != blank %}{% for link in section.settings.footer_menu_two.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="#privacy">Privacy policy</a><a href="#refund">Refund policy</a><a href="#shipping">Shipping &amp; Return</a><a href="#terms">Term &amp; conditions</a>{% endif %}</div>
      <div><h3>{{ section.settings.footer_column_three_title }}</h3><a href="{{ section.settings.facebook_url }}">Facebook</a><a href="{{ section.settings.instagram_url }}">Tweeter</a><a href="{{ section.settings.instagram_url }}">Instagram</a><a href="{{ section.settings.youtube_url }}">Youtube</a></div>
    </footer>
    <p class="kito-copyright">{{ section.settings.copyright }}</p>
  </div>
</main>{% endif %}

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;700&family=Open+Sans:wght@400;600;700&family=Sansita:wght@700;800&display=swap');
  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css');
  :root { --kito-pink: #ec80a0; --kito-ink: #1a1114; --kito-blue: #e5f8fd; --kito-lavender: #e5d8f2; --kito-peach: #ffe1c9; --kito-blush: #fdf4f7; --kito-body: #585d67; }
  * { box-sizing: border-box; }
  body { margin: 0; color: var(--kito-ink); background: #fff; font-family: Arial, sans-serif; }
  a { color: inherit; text-decoration: none; }
  .kito-home { overflow: hidden; }
  .kito-container { max-width: 1180px; margin: 0 auto; padding: 0 32px 40px; }
  .kito-header { max-width: 1180px; min-height: 78px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; gap: 36px; border-bottom: 1px solid #f3eef0; }
  .kito-logo { font-weight: 900; letter-spacing: .08em; font-size: 24px; margin: 0; }
  .kito-nav { display: flex; align-items: center; gap: 28px; margin: 0 auto; font-size: 13px; }
  .kito-nav a:hover, .kito-footer a:hover { color: var(--kito-pink); }
  .kito-actions { display: flex; gap: 16px; font-size: 18px; }
  .kito-menu-toggle { display: none; }
  .kito-page-intro { padding: 58px 0 38px; }
  .kito-page-intro h1 { margin: 6px 0; font-size: clamp(34px, 5vw, 56px); line-height: .98; }
  .kito-page-intro p:last-child { color: #8e8589; font-size: 13px; }
  .kito-eyebrow { color: var(--kito-pink); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 16px; }
  h1, h2, h3, p { margin-top: 0; }
  h2 { font-size: clamp(28px, 4vw, 46px); line-height: 1.05; margin-bottom: 20px; }
  h3 { font-size: 15px; margin-bottom: 8px; }
  p { line-height: 1.65; color: #655d62; font-size: 14px; }
  .kito-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: 390px; }
  .kito-hero-copy { padding: clamp(34px, 5vw, 74px); background: var(--kito-blue); display: flex; flex-direction: column; justify-content: center; }
  .kito-hero-copy h2 { max-width: 510px; }
  .kito-hero-copy p:not(.kito-eyebrow) { max-width: 520px; }
  .kito-media, .kito-media video, .kito-media img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .kito-hero-media { min-height: 390px; background: var(--kito-lavender); position: relative; }
  .kito-button { display: inline-flex; align-items: center; justify-content: center; width: fit-content; min-height: 42px; padding: 0 24px; color: #fff; background: var(--kito-pink); border: 0; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; transition: transform .2s ease, background .2s ease; }
  .kito-button:hover { background: #d85c87; transform: translateY(-2px); }
  .kito-section-heading { text-align: center; padding: 78px 0 28px; }
  .kito-section-heading h2 { font-size: clamp(26px, 3vw, 38px); }
  .kito-stats, .kito-team, .kito-benefits { display: grid; gap: 18px; }
  .kito-stats { grid-template-columns: repeat(4, 1fr); }
  .kito-card { background: #fff; border: 1px solid #f4eff1; box-shadow: 0 12px 28px rgba(62, 35, 45, .06); }
  .kito-stat { padding: 28px 18px; text-align: center; }
  .kito-stat strong { color: var(--kito-pink); font-size: 26px; }
  .kito-stat p, .kito-person p { font-size: 12px; margin-bottom: 0; }
  .kito-story { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding-top: 72px; }
  .kito-story-image { min-height: 310px; overflow: hidden; border-radius: 6px; background: var(--kito-lavender); }
  .kito-story-image:nth-child(2) { background: var(--kito-peach); }
  .kito-story-image img, .kito-story-image svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .kito-story-copy { min-height: 310px; padding: 38px; display: flex; flex-direction: column; justify-content: center; background: var(--kito-blush); }
  .kito-team { grid-template-columns: repeat(4, 1fr); }
  .kito-person { padding: 28px 18px 22px; text-align: center; }
  .kito-avatar { width: 76px; height: 76px; margin: 0 auto 18px; overflow: hidden; border-radius: 50%; background: var(--kito-lavender); }
  .kito-avatar img, .kito-avatar svg { width: 100%; height: 100%; display: block; object-fit: cover; }
  .kito-role { color: #b6aeb2 !important; font-size: 11px !important; }
  .kito-socials { display: flex; justify-content: center; gap: 12px; margin-top: 18px; font-size: 12px; font-weight: 700; }
  .kito-benefits { grid-template-columns: repeat(3, 1fr); padding: 72px 0 34px; }
  .kito-benefit { display: flex; align-items: center; gap: 14px; padding: 20px 0; border-top: 1px solid #f1eaed; border-bottom: 1px solid #f1eaed; }
  .kito-benefit h3, .kito-benefit p { margin-bottom: 2px; }
  .kito-benefit p { font-size: 11px; }
  .kito-benefit-icon { width: 38px; height: 38px; display: grid; place-items: center; flex: 0 0 auto; color: var(--kito-pink); border: 1px solid #f1b4c7; border-radius: 50%; font-size: 18px; }
  .kito-newsletter { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding: 34px 0; border-top: 1px solid #f1eaed; }
  .kito-newsletter p { margin-bottom: 0; }
  .kito-newsletter-form { display: flex; min-width: min(100%, 470px); }
  .kito-newsletter-form input { min-width: 0; flex: 1; padding: 0 18px; border: 1px solid #f1eaed; font: inherit; }
  .kito-footer { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 30px; padding: 46px 0 34px; border-top: 1px solid #f1eaed; }
  .kito-footer h3 { margin-bottom: 16px; }
  .kito-footer a { display: block; margin-bottom: 10px; color: #655d62; font-size: 13px; }
  .kito-copyright { padding-top: 20px; border-top: 1px solid #f1eaed; text-align: center; font-size: 11px; }
  .kito-placeholder { width: 100%; height: 100%; background: #f6f2f4; }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 749px) {
    .kito-container { padding: 0 18px 30px; }
    .kito-header { min-height: 66px; padding: 0 18px; justify-content: space-between; }
    .kito-logo { font-size: 20px; }
    .kito-menu-toggle { display: grid; width: 38px; height: 34px; place-content: center; gap: 4px; border: 0; background: transparent; cursor: pointer; }
    .kito-menu-toggle span:not(.visually-hidden) { display: block; width: 20px; height: 2px; background: var(--kito-ink); }
    .kito-nav { position: absolute; z-index: 2; top: 66px; left: 0; right: 0; display: none; flex-direction: column; align-items: stretch; gap: 0; padding: 10px 18px 18px; background: #fff; box-shadow: 0 12px 22px rgba(62, 35, 45, .08); }
    .kito-nav.is-open { display: flex; }
    .kito-nav a { padding: 12px 0; border-bottom: 1px solid #f3eef0; }
    .kito-actions { display: none; }
    .kito-page-intro { padding: 42px 0 26px; }
    .kito-hero { display: flex; flex-direction: column-reverse; min-height: 0; }
    .kito-hero-media { min-height: 270px; }
    .kito-hero-copy { padding: 34px 24px 38px; text-align: center; align-items: center; }
    .kito-hero-copy h2 { font-size: 32px; }
    .kito-stats, .kito-team { grid-template-columns: 1fr; }
    .kito-section-heading { padding: 54px 0 22px; }
    .kito-story { grid-template-columns: repeat(2, 1fr); gap: 10px; padding-top: 48px; }
    .kito-story-image { min-height: 190px; }
    .kito-story-copy { grid-column: 1 / -1; min-height: 250px; padding: 28px 24px; text-align: center; align-items: center; }
    .kito-benefits { grid-template-columns: 1fr; gap: 0; padding: 48px 0 24px; }
    .kito-newsletter { display: block; text-align: center; padding: 30px 0; }
    .kito-newsletter-form { min-width: 0; margin-top: 22px; }
    .kito-newsletter-form input { min-height: 44px; }
    .kito-footer { grid-template-columns: 1fr 1fr; gap: 28px 18px; padding-top: 34px; }
    .kito-footer > div:first-child { grid-column: 1 / -1; }
  }
  .kito-topbar { height: 40px; display: flex; align-items: center; justify-content: space-between; padding: 0 max(20px, calc((100vw - 1410px) / 2)); color: var(--kito-ink); background: rgba(236,128,160,.1); font: 400 15px/26px 'Open Sans', sans-serif; }
  .kito-topbar strong { color: #c81b10; font-weight: 400; }
  .kito-header { max-width: 1410px; height: 110px; min-height: 110px; padding: 0; border: 0; box-shadow: none; }
  .kito-header .kito-logo { position: absolute; left: 50%; transform: translateX(-50%); font: 800 54px/70px 'Sansita', sans-serif; text-transform: uppercase; letter-spacing: 0; }
  .kito-nav { order: -1; margin: 0; gap: 30px; font: 700 15px/26px 'Open Sans', sans-serif; }
  .kito-actions { margin-left: auto; gap: 30px; font-size: 22px; }
  .kito-actions > a { position: relative; display: block; width: 25px; height: 25px; }
  .kito-actions img { display: block; width: 25px; height: 25px; object-fit: contain; }
  .kito-action-count { position: absolute; top: 12px; left: 12px; min-width: 18px; height: 18px; padding: 2px 5px; color: #fff; background: var(--kito-ink); border: 1px solid #fff; border-radius: 10px; font: 600 10px/14px 'Open Sans', sans-serif; text-align: center; }
  .kito-page-intro { max-width: 1410px; padding: 90px 0 80px; }
  .kito-page-intro h1 { margin: 0 0 15px; font: 700 54px/70px 'Sansita', sans-serif; text-transform: none; }
  .kito-page-intro p:last-child { margin: 0; color: var(--kito-ink); font: 400 15px/26px 'Open Sans', sans-serif; }
  .kito-eyebrow { display: inline-block; padding: 5px 12px; color: var(--kito-pink); background: rgba(236,128,160,.15); border-radius: 5px; font: 700 15px/26px 'Open Sans', sans-serif; letter-spacing: 0; }
  .kito-hero-copy .kito-eyebrow { align-self: flex-start; width: max-content; flex: 0 0 auto; margin-bottom: 16px; }
  .kito-container { max-width: 1410px; padding: 0 0 40px; }
  h2 { font-family: 'Sansita', sans-serif; font-weight: 700; }
  p, .kito-nav, .kito-footer a, .kito-footer p { font-family: 'Open Sans', sans-serif; }
  .kito-hero { grid-template-columns: 1fr 1fr; min-height: 600px; }
  .kito-hero-copy { padding: 112px 90px; background: var(--kito-blue); }
  .kito-hero-copy h2 { max-width: 560px; margin: 0 0 24px; font: 700 54px/70px 'Sansita', sans-serif; text-transform: none; }
  .kito-hero-copy p:not(.kito-eyebrow) { max-width: 520px; font: 400 15px/26px 'Open Sans', sans-serif; color: var(--kito-body); }
  .kito-hero-media { min-height: 600px; }
  .kito-hero-art { position: relative; width: 100%; height: 100%; min-height: 600px; overflow: hidden; background: #e5f8fd; }
  .kito-hero-art img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .kito-play { position: absolute; top: 50%; left: 50%; display: grid; width: 90px; height: 90px; place-items: center; transform: translate(-50%, -50%); color: var(--kito-pink); background: #fff; border: 0; border-radius: 50%; font-size: 34px; }
  .kito-button { min-height: 56px; padding: 0 40px; border-radius: 10px; font: 700 17px/22px 'Open Sans', sans-serif; letter-spacing: 1.7px; }
  .kito-hero-copy .kito-button { min-height: 60px; padding: 17px 40px; font-size: 20px; line-height: 26px; letter-spacing: 2px; }
  .kito-section-heading { padding: 100px 0 35px; }
  .kito-section-heading h2 { margin: 0; font: 700 54px/70px 'Sansita', sans-serif; text-transform: none; }
  .kito-stats { grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .kito-card { border: 0; border-radius: 10px; box-shadow: 0 4px 30px rgba(10,30,35,.1); }
  .kito-stat { height: 248px; padding: 40px 30px 24px; }
  .kito-stat strong { display: block; color: var(--kito-pink); font: 700 42px/55px 'Sansita', sans-serif; }
  .kito-stat h3 { margin: 10px 0 10px; color: var(--kito-ink); font: 700 24px/31px 'Barlow', sans-serif; }
  .kito-stat p, .kito-person p { color: var(--kito-body); font: 400 15px/26px 'Open Sans', sans-serif; }
  .kito-story { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; padding-top: 100px; align-items: start; }
  .kito-story > * { width: 100%; min-width: 0; }
  .kito-story-image { height: 550px; min-height: 550px; border-radius: 20px; align-self: start; }
  .kito-story-image:nth-child(2) { position: relative; top: -63px; height: 675px !important; min-height: 675px !important; margin-bottom: -125px; z-index: 1; }
  .kito-story-copy { height: 550px; min-height: 550px; padding: 70px 60px; border-radius: 20px; align-items: center; overflow: hidden; }
  .kito-story-copy h2 { width: 420px; max-width: 100%; margin-bottom: 24px; font: 700 54px/70px 'Sansita', sans-serif; text-align: center; text-transform: none; }
  .kito-story-copy p { max-width: 323px; margin-bottom: 28px; color: #0a1e23; font: 400 15px/26px 'Open Sans', sans-serif; text-align: center; }
  .kito-story-copy .kito-button { min-height: 50px; padding: 14px 30px; }
  .kito-team-heading { padding-top: 225px; }
  .kito-team { grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .kito-person { height: 390px; padding: 40px 30px 22px; }
  .kito-person h3 { margin: 0 0 5px; font: 700 24px/31px 'Barlow', sans-serif; }
  .kito-person .kito-role { margin: 0 0 10px; opacity: .5; }
  .kito-avatar { width: 130px; height: 130px; margin-bottom: 25px; }
  .kito-benefits { grid-template-columns: repeat(3, 1fr); gap: 30px; padding: 100px 0 40px; }
  .kito-benefit { gap: 20px; padding: 0; border: 0; }
  .kito-benefit-icon { width: 60px; height: 60px; border-radius: 50%; font: 30px/54px 'FontAwesome'; text-align: center; }
  .kito-benefit h3 { margin: 0 0 10px; font: 700 24px/31px 'Sansita', sans-serif; }
  .kito-benefit p { margin: 0; font: 400 15px/26px 'Open Sans', sans-serif; color: var(--kito-body); }
  .kito-newsletter { display: grid; grid-template-columns: 1.4fr 1.15fr 1.15fr; align-items: center; gap: 30px; padding: 0 0 70px; border: 0; }
  .kito-newsletter .kito-logo { font: 800 54px/70px 'Sansita', sans-serif; text-transform: uppercase; }
  .kito-newsletter-promo { margin: 0; font: 700 15px/22px 'Open Sans', sans-serif; }
  .kito-newsletter-form { min-width: 0; width: 496px; max-width: 100%; }
  .kito-newsletter-form input { height: 50px; border-color: var(--kito-pink); border-radius: 10px 0 0 10px; font: 400 15px/26px 'Open Sans', sans-serif; }
  .kito-newsletter-form .kito-button { min-height: 50px; height: 50px; align-self: stretch; box-sizing: border-box; border-radius: 0 10px 10px 0; }
  .kito-footer { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 30px; padding: 70px 0 34px; }
  .kito-footer .kito-logo { font: 800 54px/70px 'Sansita', sans-serif; text-transform: uppercase; }
  .kito-footer-contact h3 { margin-top: 28px; }
  .kito-footer h3 { font: 700 24px/31px 'Sansita', sans-serif; }
  .kito-copyright { font: 400 15px/26px 'Open Sans', sans-serif; }
  @media (max-width: 749px) {
    .kito-topbar { display: none; }
    .kito-header { max-width: none; height: 75px; min-height: 75px; padding: 0 20px; }
    .kito-header .kito-logo { position: static; transform: none; font-size: 30px; line-height: 55px; }
    .kito-menu-toggle { order: 2; }
    .kito-container { max-width: none; padding: 0 20px 30px; }
    .kito-page-intro { padding: 60px 0 30px; text-align: center; }
    .kito-page-intro h1 { font-size: 36px; line-height: 47px; }
    .kito-hero { margin: 0 -20px; }
    .kito-hero-media { min-height: 364px; height: 364px; }
    .kito-hero-art { min-height: 364px; }
    .kito-play { width: 60px; height: 60px; font-size: 22px; }
    .kito-hero-copy { min-height: 369px; padding: 60px 30px 45px; }
    .kito-hero-copy .kito-eyebrow { align-self: center; }
    .kito-hero-copy h2 { font-size: 30px; line-height: 40px; text-align: center; }
    .kito-hero-copy p:not(.kito-eyebrow) { text-align: center; }
    .kito-section-heading { padding: 76px 0 25px; }
    .kito-section-heading h2 { font-size: 36px; line-height: 47px; text-align: center; }
    .kito-stats { grid-template-columns: 1fr; gap: 20px; }
    .kito-stat { height: 215px; padding: 30px; }
    .kito-stat strong { font-size: 36px; line-height: 47px; }
    .kito-story { grid-template-columns: repeat(2, 1fr); gap: 10px; padding-top: 60px; }
    .kito-story-image { height: 300px; min-height: 300px; border-radius: 20px; }
    .kito-story-image:nth-child(2) { top: -25px; height: 350px !important; min-height: 350px !important; margin-bottom: -50px; }
    .kito-story-copy { grid-column: 1 / -1; height: 356px; min-height: 356px; padding: 40px 20px; text-align: center; }
    .kito-story-copy h2 { width: 100%; font-size: 36px; line-height: 47px; }
    .kito-team-heading { padding-top: 60px; }
    .kito-team { grid-template-columns: 1fr; gap: 20px; }
    .kito-person { height: 390px; }
    .kito-benefits { grid-template-columns: 1fr; gap: 36px; margin-top: 60px; padding: 30px; border: 1px solid rgba(26,17,20,.1); border-radius: 10px; }
    .kito-newsletter { display: block; padding: 60px 0 30px; text-align: center; }
    .kito-newsletter .kito-logo { font-size: 30px; line-height: 55px; }
    .kito-newsletter-promo { margin: 18px 0 0; }
    .kito-newsletter-form { width: 100%; margin-top: 22px; }
    .kito-footer { grid-template-columns: 1fr; gap: 35px; padding-top: 45px; }
    .kito-footer .kito-logo { font-size: 30px; line-height: 55px; text-align: center; }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.kito-menu-toggle').forEach(function (button) {
    button.addEventListener('click', function () {
      var nav = document.getElementById(button.getAttribute('aria-controls'));
      var open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });
  });
{% endjavascript %}

