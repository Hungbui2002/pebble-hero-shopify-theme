{%- liquid
  assign desktop_menu = section.settings.desktop_menu
  assign mobile_menu = section.settings.mobile_menu
  if mobile_menu == blank
    assign mobile_menu = desktop_menu
  endif
  assign transparent_header = false
  if request.page_type == 'index' and section.settings.transparent_header
    assign transparent_header = true
  endif
  assign popular_searches = section.settings.popular_searches | newline_to_br | split: '<br />'
  assign sale_collection = section.settings.men_sale_collection
  if sale_collection == blank
    assign sale_collection = collections['all']
  endif
  assign search_placeholder = 'sections.helix_header.search_placeholder' | t
  if settings.search_placeholder != blank
    assign search_placeholder = settings.search_placeholder
  endif
  assign fallback_logo_url = 'https://helix-shoes-theme.myshopify.com/cdn/shop/files/logo.svg?v=1776243138&width=180'
-%}

<helix-store-header
  class="helix-header{% if transparent_header %} is-transparent{% endif %}{% unless section.settings.sticky_desktop %} helix-header--desktop-static{% endunless %}{% unless section.settings.sticky_mobile %} helix-header--mobile-static{% endunless %}"
  data-sticky-desktop="{{ section.settings.sticky_desktop }}"
  data-sticky-mobile="{{ section.settings.sticky_mobile }}"
  data-cart-drawer="{{ section.settings.cart_drawer }}"
  data-cart-url="{{ routes.cart_url }}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-predictive-section="helix-predictive-search"
  data-currency="{{ localization.country.currency.iso_code }}"
  data-cart-label="{{ 'sections.helix_header.cart' | t | escape }}"
  data-quantity-label="{{ 'sections.helix_header.quantity' | t | escape }}"
  style="--helix-header-bg: {{ section.settings.background }}; --helix-header-text: {{ section.settings.text_color }}; --helix-header-transparent-text: {{ section.settings.transparent_text_color }}; --helix-header-border: {{ section.settings.border_color }}; --helix-header-radius: {{ section.settings.corner_radius }}px; --helix-header-duration: {{ section.settings.animation_duration }}ms; --helix-logo-width: {{ section.settings.logo_width }}px; --helix-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;"
>
  <svg class="helix-header__sprite" aria-hidden="true">
    <symbol id="HelixIconSearch" viewBox="0 0 24 24"><path d="M21 21 16.7 16.7M19 11C19 15.418 15.418 19 11 19S3 15.418 3 11 6.582 3 11 3s8 3.582 8 8Z"/></symbol>
    <symbol id="HelixIconAccount" viewBox="0 0 24 24"><path d="M12 13c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5Zm0 0a9.192 9.192 0 0 1 8 8m-8-8a9.192 9.192 0 0 0-8 8"/></symbol>
    <symbol id="HelixIconBag" viewBox="0 0 24 25"><path d="m3 6.5 3-4h12l3 4m-18 0v14c0 1.105.895 2 2 2h14c1.105 0 2-.895 2-2v-14m-18 0h18m-5 4a4 4 0 0 1-8 0"/></symbol>
    <symbol id="HelixIconMenu" viewBox="0 0 24 24"><path d="M3 7h18M3 12h18M3 17h18"/></symbol>
    <symbol id="HelixIconClose" viewBox="0 0 24 24"><path d="m5 5 14 14M19 5 5 19"/></symbol>
    <symbol id="HelixIconChevron" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></symbol>
    <symbol id="HelixIconArrow" viewBox="0 0 24 24"><path d="M4 12h16M14 6l6 6-6 6"/></symbol>
    <symbol id="HelixIconBack" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
  </svg>

  <div class="helix-header__shell" data-header-shell>
    <div class="helix-header__desktop">
      <nav class="helix-nav" aria-label="{{ 'sections.helix_header.primary_navigation' | t }}">
        {%- if desktop_menu != blank -%}
          {%- for link in desktop_menu.links -%}
            {%- assign is_mega = false -%}
            {%- if link.links != blank and forloop.index <= 2 -%}
              {%- assign is_mega = true -%}
            {%- endif -%}
            <div class="helix-nav__item{% if is_mega %} helix-nav__item--mega{% endif %}"{% if link.links != blank %} data-menu-item{% endif %}>
              <span class="helix-nav__entry">
                <a class="helix-nav__link" href="{{ link.url }}"{% if link.links != blank %} data-touch-menu-link{% endif %}><span class="helix-nav__label">{{ link.title }}</span></a>
                {%- if link.links != blank -%}
                  <button class="helix-nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="HelixMenu-{{ section.id }}-{{ forloop.index }}" aria-label="{{ 'sections.helix_header.open_menu' | t: title: link.title }}">
                    <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconChevron"/></svg>
                  </button>
                {%- endif -%}
              </span>
              {%- if link.links != blank -%}
                <div id="HelixMenu-{{ section.id }}-{{ forloop.index }}" class="helix-nav__panel{% if is_mega %} helix-nav__panel--mega{% else %} helix-nav__panel--dropdown{% endif %}" data-menu-panel>
                  {%- if is_mega -%}
                    <div class="helix-mega">
                      <div class="helix-mega__featured">
                        <ul>
                          {%- for child_link in link.links -%}
                            {%- if child_link.links == blank -%}
                              <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </div>
                      {%- for child_link in link.links -%}
                        {%- if child_link.links != blank -%}
                          <div class="helix-mega__group">
                            <a class="helix-mega__group-title" href="{{ child_link.url }}">{{ child_link.title }}</a>
                            <ul>
                              {%- for grandchild_link in child_link.links -%}
                                <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if forloop.index == 1 -%}
                        <div class="helix-mega__promos">
                          {%- for block in section.blocks -%}
                            {%- if block.type == 'mega_banner' -%}
                              {%- assign banner_link = block.settings.link | default: link.url -%}
                              <article class="helix-mega__promo" {{ block.shopify_attributes }}>
                                <a href="{{ banner_link }}" aria-label="{{ block.settings.heading | escape }}">
                                  <span class="helix-mega__promo-media{% if block.settings.image == blank %} is-placeholder{% endif %}">
                                    {%- if block.settings.image != blank -%}
                                      {%- assign banner_alt = block.settings.image.alt | default: block.settings.heading -%}
                                      {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,560,700', sizes: '(min-width: 991px) 18vw', alt: banner_alt }}
                                    {%- endif -%}
                                  </span>
                                  <span class="helix-mega__promo-copy">
                                    <span>{{ block.settings.heading }}</span>
                                    <strong>{{ block.settings.cta }}</strong>
                                  </span>
                                </a>
                              </article>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <div class="helix-mega__products-wrap">
                          <div class="helix-mega__products-header">
                            <h3>{{ 'sections.helix_header.on_sale' | t }}</h3>
                            <span class="helix-mega__product-controls">
                              <button type="button" data-mega-previous aria-label="{{ 'sections.helix_header.previous_products' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconBack"/></svg></button>
                              <button type="button" data-mega-next aria-label="{{ 'sections.helix_header.next_products' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconArrow"/></svg></button>
                            </span>
                          </div>
                          <div class="helix-mega__products" data-mega-products>
                            {%- for product in sale_collection.products limit: 5 -%}
                              {%- assign compare_price = product.compare_at_price -%}
                              {%- assign current_price = product.price -%}
                              <article class="helix-mega-product">
                                <a class="helix-mega-product__media" href="{{ product.url }}">
                                  {%- if product.featured_image != blank -%}
                                    {%- assign product_alt = product.featured_image.alt | default: product.title -%}
                                    {{ product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180,280,360,420', sizes: '170px', alt: product_alt }}
                                  {%- else -%}
                                    {{ 'product-1' | placeholder_svg_tag }}
                                  {%- endif -%}
                                  {%- if compare_price > current_price -%}
                                    {%- assign savings = compare_price | minus: current_price | times: 100 | divided_by: compare_price -%}
                                    <span class="helix-mega-product__badge">-{{ savings }}%</span>
                                  {%- endif -%}
                                </a>
                                <div class="helix-mega-product__content">
                                  <a href="{{ product.url }}">{{ product.title }}</a>
                                  <span class="helix-mega-product__price"><strong>{{ current_price | money }}</strong>{% if compare_price > current_price %}<s>{{ compare_price | money }}</s>{% endif %}</span>
                                  {%- if product.available -%}
                                    <form method="post" action="{{ routes.cart_add_url }}" data-helix-quick-add>
                                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                                      <input type="hidden" name="quantity" value="1">
                                      <button type="submit" aria-label="{{ 'sections.helix_header.quick_add_named' | t: title: product.title }}">{{ 'sections.helix_header.quick_add' | t }}</button>
                                    </form>
                                  {%- endif -%}
                                </div>
                              </article>
                            {%- endfor -%}
                          </div>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    <ul class="helix-dropdown-menu">
                      {%- for child_link in link.links -%}
                        <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <a class="helix-nav__link" href="{{ routes.all_products_collection_url }}"><span class="helix-nav__label">{{ 'sections.helix_header.shop_all' | t }}</span></a>
        {%- endif -%}
      </nav>

      <a class="helix-header__logo{% if section.settings.transparent_logo != blank %} has-transparent-logo{% endif %}" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
          <span class="helix-header__logo-image helix-header__logo-image--default">{{ section.settings.logo | image_url: width: 420 | image_tag: widths: '110,180,220,320,420', sizes: 'var(--helix-logo-width)', alt: logo_alt }}</span>
          {%- if section.settings.transparent_logo != blank -%}
            {%- assign transparent_logo_alt = section.settings.transparent_logo.alt | default: shop.name -%}
            <span class="helix-header__logo-image helix-header__logo-image--transparent">{{ section.settings.transparent_logo | image_url: width: 420 | image_tag: widths: '110,180,220,320,420', sizes: 'var(--helix-logo-width)', alt: transparent_logo_alt }}</span>
          {%- endif -%}
        {%- else -%}
          <img class="helix-header__fallback-logo" src="{{ fallback_logo_url | escape }}" width="110" height="19" alt="{{ shop.name | escape }}">
        {%- endif -%}
      </a>

      <div class="helix-header__utilities">
        {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
          {% form 'localization', id: 'HelixDesktopLocalization', class: 'helix-localization helix-localization--desktop' %}
            <details data-desktop-localization>
              <summary aria-label="{{ 'sections.helix_header.country_currency' | t }}">
                <span>{{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</span>
                <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconChevron"/></svg>
              </summary>
              <div class="helix-localization__popover">
                <label class="helix-localization__search">
                  <span class="helix-visually-hidden">{{ 'sections.helix_header.search_countries' | t }}</span>
                  <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconSearch"/></svg>
                  <input type="search" data-country-search placeholder="{{ 'sections.helix_header.search_countries' | t }}" autocomplete="off">
                </label>
                <div class="helix-localization__list" role="listbox" aria-label="{{ 'sections.helix_header.countries' | t }}">
                  {%- for country in localization.available_countries -%}
                    <button type="submit" name="country_code" value="{{ country.iso_code }}" data-country-option data-search-value="{{ country.name | downcase | escape }} {{ country.currency.iso_code | downcase }}" role="option" aria-selected="{% if country.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}">
                      <span>{{ country.name }}</span><small>{{ country.currency.iso_code }} {{ country.currency.symbol }}</small>
                    </button>
                  {%- endfor -%}
                </div>
                {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
                  <p class="helix-localization__label">{{ 'sections.helix_header.language' | t }}</p>
                  <div class="helix-localization__languages">
                    {%- for language in localization.available_languages -%}
                      <button type="submit" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}" aria-current="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}">{{ language.endonym_name | capitalize }}</button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </details>
          {% endform %}
        {%- endif -%}
        {%- if section.settings.show_country and localization.available_countries.size > 1 and section.settings.show_search -%}
          <span class="helix-header__utility-divider" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.show_search -%}
          <a class="helix-header__utility" href="{{ routes.search_url }}" data-overlay-open="search" aria-haspopup="dialog" aria-expanded="false" aria-controls="HelixSearchDrawer-{{ section.id }}" aria-label="{{ 'sections.helix_header.search' | t }}">
            <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconSearch"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_account -%}
          <a class="helix-header__utility" href="{{ routes.account_url }}" aria-label="{% if customer %}{{ 'sections.helix_header.account' | t }}{% else %}{{ 'sections.helix_header.login' | t }}{% endif %}">
            <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconAccount"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.show_cart -%}
          <a class="helix-header__utility helix-header__cart" href="{{ routes.cart_url }}"{% if section.settings.cart_drawer %} data-overlay-open="cart" aria-haspopup="dialog" aria-expanded="false" aria-controls="HelixCartDrawer-{{ section.id }}"{% endif %} aria-label="{{ 'sections.helix_header.cart_count' | t: count: cart.item_count }}">
            <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconBag"/></svg>
            <span class="helix-header__cart-count" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="helix-header__mobile">
      <button class="helix-header__utility" type="button" data-overlay-open="menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="HelixMobileMenu-{{ section.id }}" aria-label="{{ 'sections.helix_header.open_navigation' | t }}">
        <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconMenu"/></svg>
      </button>
      <a class="helix-header__logo{% if section.settings.transparent_logo != blank %} has-transparent-logo{% endif %}" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          <span class="helix-header__logo-image helix-header__logo-image--default">{{ section.settings.logo | image_url: width: 320 | image_tag: widths: '90,140,180,240,320', sizes: 'var(--helix-mobile-logo-width)', alt: logo_alt }}</span>
          {%- if section.settings.transparent_logo != blank -%}
            <span class="helix-header__logo-image helix-header__logo-image--transparent">{{ section.settings.transparent_logo | image_url: width: 320 | image_tag: widths: '90,140,180,240,320', sizes: 'var(--helix-mobile-logo-width)', alt: transparent_logo_alt }}</span>
          {%- endif -%}
        {%- else -%}
          <img class="helix-header__fallback-logo" src="{{ fallback_logo_url | escape }}" width="110" height="19" alt="{{ shop.name | escape }}">
        {%- endif -%}
      </a>
      <div class="helix-header__mobile-actions">
        {%- if section.settings.show_search -%}
          <a class="helix-header__utility" href="{{ routes.search_url }}" data-overlay-open="search" aria-haspopup="dialog" aria-expanded="false" aria-controls="HelixSearchDrawer-{{ section.id }}" aria-label="{{ 'sections.helix_header.search' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconSearch"/></svg></a>
        {%- endif -%}
        {%- if section.settings.show_cart -%}
          <a class="helix-header__utility helix-header__cart" href="{{ routes.cart_url }}"{% if section.settings.cart_drawer %} data-overlay-open="cart" aria-haspopup="dialog" aria-expanded="false" aria-controls="HelixCartDrawer-{{ section.id }}"{% endif %} aria-label="{{ 'sections.helix_header.cart_count' | t: count: cart.item_count }}">
            <svg class="helix-icon" aria-hidden="true"><use href="#HelixIconBag"/></svg>
            <span class="helix-header__cart-count" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div id="HelixMobileMenu-{{ section.id }}" class="helix-overlay helix-overlay--menu" data-overlay="menu" aria-hidden="true">
    <button class="helix-overlay__backdrop" type="button" data-overlay-backdrop aria-label="{{ 'sections.helix_header.close_navigation' | t }}"></button>
    <div class="helix-overlay__panel helix-overlay__panel--left" role="dialog" aria-modal="true" aria-label="{{ 'sections.helix_header.menu' | t }}">
      <section class="helix-mobile-panel is-active" data-mobile-panel="root">
        <header class="helix-drawer__header">
          <strong>{{ 'sections.helix_header.menu' | t }}</strong>
          <button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_navigation' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button>
        </header>
        <nav class="helix-mobile-nav" aria-label="{{ 'sections.helix_header.mobile_navigation' | t }}">
          <ul>
            {%- if mobile_menu != blank -%}
              {%- for link in mobile_menu.links -%}
                <li>
                  <span class="helix-mobile-nav__row">
                    <a href="{{ link.url }}">{{ link.title }}</a>
                    {%- if link.links != blank -%}
                      <button type="button" data-panel-target="level-{{ forloop.index }}" aria-label="{{ 'sections.helix_header.open_menu' | t: title: link.title }}"><svg class="helix-icon helix-icon--right" aria-hidden="true"><use href="#HelixIconChevron"/></svg></button>
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            {%- else -%}
              <li><span class="helix-mobile-nav__row"><a href="{{ routes.all_products_collection_url }}">{{ 'sections.helix_header.shop_all' | t }}</a></span></li>
            {%- endif -%}
          </ul>
          <div class="helix-mobile-nav__utilities">
            {%- if section.settings.show_account -%}
              <a href="{{ routes.account_url }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconAccount"/></svg><span>{% if customer %}{{ 'sections.helix_header.account' | t }}{% else %}{{ 'sections.helix_header.login' | t }}{% endif %}</span></a>
            {%- endif -%}
            {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
              <button type="button" data-overlay-open="country" aria-haspopup="dialog" aria-controls="HelixCountrySheet-{{ section.id }}"><span>{{ 'sections.helix_header.country_currency' | t }}</span><small>{{ localization.country.name }} · {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</small></button>
            {%- endif -%}
            {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
              <button type="button" data-overlay-open="language" aria-haspopup="dialog" aria-controls="HelixLanguageSheet-{{ section.id }}"><span>{{ 'sections.helix_header.language' | t }}</span><small>{{ localization.language.endonym_name | capitalize }}</small></button>
            {%- endif -%}
          </div>
        </nav>
      </section>

      {%- if mobile_menu != blank -%}
        {%- for link in mobile_menu.links -%}
          {%- assign parent_index = forloop.index -%}
          {%- if link.links != blank -%}
            <section class="helix-mobile-panel" data-mobile-panel="level-{{ parent_index }}">
              <header class="helix-drawer__header">
                <button type="button" data-panel-back="root" aria-label="{{ 'sections.helix_header.back' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconBack"/></svg></button>
                <strong>{{ link.title }}</strong>
                <button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_navigation' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button>
              </header>
              <nav class="helix-mobile-nav" aria-label="{{ link.title | escape }}">
                <a class="helix-mobile-nav__view-all" href="{{ link.url }}">{{ 'sections.helix_header.view_all_named' | t: title: link.title }}<svg class="helix-icon" aria-hidden="true"><use href="#HelixIconArrow"/></svg></a>
                <ul>
                  {%- for child_link in link.links -%}
                    <li>
                      <span class="helix-mobile-nav__row">
                        <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                        {%- if child_link.links != blank -%}
                          <button type="button" data-panel-target="level-{{ parent_index }}-{{ forloop.index }}" aria-label="{{ 'sections.helix_header.open_menu' | t: title: child_link.title }}"><svg class="helix-icon helix-icon--right" aria-hidden="true"><use href="#HelixIconChevron"/></svg></button>
                        {%- endif -%}
                      </span>
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>
            </section>
            {%- for child_link in link.links -%}
              {%- if child_link.links != blank -%}
                <section class="helix-mobile-panel" data-mobile-panel="level-{{ parent_index }}-{{ forloop.index }}">
                  <header class="helix-drawer__header">
                    <button type="button" data-panel-back="level-{{ parent_index }}" aria-label="{{ 'sections.helix_header.back' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconBack"/></svg></button>
                    <strong>{{ child_link.title }}</strong>
                    <button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_navigation' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button>
                  </header>
                  <nav class="helix-mobile-nav" aria-label="{{ child_link.title | escape }}">
                    <a class="helix-mobile-nav__view-all" href="{{ child_link.url }}">{{ 'sections.helix_header.view_all_named' | t: title: child_link.title }}<svg class="helix-icon" aria-hidden="true"><use href="#HelixIconArrow"/></svg></a>
                    <ul>
                      {%- for grandchild_link in child_link.links -%}
                        <li><span class="helix-mobile-nav__row"><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></span></li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                </section>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_search -%}
    <div id="HelixSearchDrawer-{{ section.id }}" class="helix-overlay helix-overlay--drawer" data-overlay="search" aria-hidden="true">
      <button class="helix-overlay__backdrop" type="button" data-overlay-backdrop aria-label="{{ 'sections.helix_header.close_search' | t }}"></button>
      <div class="helix-overlay__panel helix-overlay__panel--right" role="dialog" aria-modal="true" aria-labelledby="HelixSearchTitle-{{ section.id }}">
        <header class="helix-drawer__header">
          <h2 id="HelixSearchTitle-{{ section.id }}">{{ 'sections.helix_header.search' | t }}</h2>
          <button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_search' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button>
        </header>
        <div class="helix-drawer__body">
          <form class="helix-search" action="{{ routes.search_url }}" method="get" role="search">
            <label for="HelixSearchInput-{{ section.id }}">{{ 'sections.helix_header.search' | t }}</label>
            <span class="helix-search__field">
              <input id="HelixSearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ search_placeholder | escape }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="HelixPredictiveContainer-{{ section.id }}" aria-expanded="false" data-predictive-input data-overlay-autofocus>
              <button type="submit" aria-label="{{ 'sections.helix_header.submit_search' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconSearch"/></svg></button>
            </span>
          </form>
          <section class="helix-popular-searches" data-popular-searches>
            <h3>{{ 'sections.helix_header.popular_searches' | t }}</h3>
            <div>
              {%- for term in popular_searches -%}
                {%- assign clean_term = term | strip -%}
                {%- if clean_term != blank -%}
                  <a href="{{ routes.search_url }}?q={{ clean_term | url_encode }}&type=product">{{ clean_term }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
          <div id="HelixPredictiveContainer-{{ section.id }}" class="helix-predictive" data-predictive-results aria-live="polite"></div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_cart and section.settings.cart_drawer -%}
    <div id="HelixCartDrawer-{{ section.id }}" class="helix-overlay helix-overlay--drawer" data-overlay="cart" aria-hidden="true">
      <button class="helix-overlay__backdrop" type="button" data-overlay-backdrop aria-label="{{ 'sections.helix_header.close_cart' | t }}"></button>
      <div class="helix-overlay__panel helix-overlay__panel--right" role="dialog" aria-modal="true" aria-labelledby="HelixCartTitle-{{ section.id }}">
        <header class="helix-drawer__header">
          <h2 id="HelixCartTitle-{{ section.id }}" data-cart-heading>{{ 'sections.helix_header.cart_heading' | t: count: cart.item_count }}</h2>
          <button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_cart' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button>
        </header>
        <div class="helix-cart">
          <div class="helix-cart__items" data-cart-items{% if cart.item_count == 0 %} hidden{% endif %}>
            {%- for item in cart.items -%}
              {%- assign cart_item_alt = item.image.alt | default: item.product.title -%}
              <article class="helix-cart-item">
                <a href="{{ item.url }}" class="helix-cart-item__image">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,140,180', sizes: '72px', alt: cart_item_alt }}{% endif %}</a>
                <div><a href="{{ item.url }}">{{ item.product.title }}</a><small>{{ item.variant.title }}</small><span>{{ 'sections.helix_header.quantity' | t }}: {{ item.quantity }}</span><strong>{{ item.final_line_price | money }}</strong></div>
              </article>
            {%- endfor -%}
          </div>
          <div class="helix-cart__empty" data-cart-empty{% if cart.item_count > 0 %} hidden{% endif %}>
            <h3>{{ 'sections.helix_header.cart_empty' | t }}</h3>
            <p>{{ 'sections.helix_header.cart_empty_description' | t }}</p>
            <div class="helix-cart__suggestions">
              {%- for collection_setting in (1..3) -%}
                {%- case collection_setting -%}
                  {%- when 1 -%}{%- assign suggested_collection = section.settings.empty_collection_1 -%}
                  {%- when 2 -%}{%- assign suggested_collection = section.settings.empty_collection_2 -%}
                  {%- when 3 -%}{%- assign suggested_collection = section.settings.empty_collection_3 -%}
                {%- endcase -%}
                {%- if suggested_collection != blank -%}
                  <a href="{{ suggested_collection.url }}">{{ suggested_collection.title }}<svg class="helix-icon" aria-hidden="true"><use href="#HelixIconArrow"/></svg></a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="helix-cart__footer" data-cart-filled{% if cart.item_count == 0 %} hidden{% endif %}>
            <p><span>{{ 'sections.helix_header.subtotal' | t }}</span><strong data-cart-total>{{ cart.total_price | money }}</strong></p>
            <a href="{{ routes.cart_url }}">{{ 'sections.helix_header.view_cart' | t }}</a>
            <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout">{{ 'sections.helix_header.checkout' | t }}</button></form>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
    <div id="HelixCountrySheet-{{ section.id }}" class="helix-overlay helix-overlay--sheet" data-overlay="country" aria-hidden="true">
      <button class="helix-overlay__backdrop" type="button" data-overlay-backdrop aria-label="{{ 'sections.helix_header.close_country' | t }}"></button>
      <div class="helix-overlay__panel helix-overlay__panel--sheet" role="dialog" aria-modal="true" aria-labelledby="HelixCountryTitle-{{ section.id }}">
        <header class="helix-drawer__header"><h2 id="HelixCountryTitle-{{ section.id }}">{{ 'sections.helix_header.country_currency' | t }}</h2><button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_country' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button></header>
        {% form 'localization', id: 'HelixMobileCountryLocalization', class: 'helix-localization helix-localization--sheet' %}
          <label class="helix-localization__search"><span class="helix-visually-hidden">{{ 'sections.helix_header.search_countries' | t }}</span><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconSearch"/></svg><input type="search" data-country-search data-overlay-autofocus placeholder="{{ 'sections.helix_header.search_countries' | t }}" autocomplete="off"></label>
          <div class="helix-localization__list" role="listbox" aria-label="{{ 'sections.helix_header.countries' | t }}">
            {%- for country in localization.available_countries -%}<button type="submit" name="country_code" value="{{ country.iso_code }}" data-country-option data-search-value="{{ country.name | downcase | escape }} {{ country.currency.iso_code | downcase }}" role="option" aria-selected="{% if country.iso_code == localization.country.iso_code %}true{% else %}false{% endif %}"><span>{{ country.name }}</span><small>{{ country.currency.iso_code }} {{ country.currency.symbol }}</small></button>{%- endfor -%}
          </div>
        {% endform %}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
    <div id="HelixLanguageSheet-{{ section.id }}" class="helix-overlay helix-overlay--sheet" data-overlay="language" aria-hidden="true">
      <button class="helix-overlay__backdrop" type="button" data-overlay-backdrop aria-label="{{ 'sections.helix_header.close_language' | t }}"></button>
      <div class="helix-overlay__panel helix-overlay__panel--sheet" role="dialog" aria-modal="true" aria-labelledby="HelixLanguageTitle-{{ section.id }}">
        <header class="helix-drawer__header"><h2 id="HelixLanguageTitle-{{ section.id }}">{{ 'sections.helix_header.language' | t }}</h2><button type="button" data-overlay-close aria-label="{{ 'sections.helix_header.close_language' | t }}"><svg class="helix-icon" aria-hidden="true"><use href="#HelixIconClose"/></svg></button></header>
        {% form 'localization', id: 'HelixMobileLanguageLocalization', class: 'helix-localization helix-localization--sheet' %}
          <div class="helix-localization__list" role="listbox" aria-label="{{ 'sections.helix_header.languages' | t }}">
            {%- for language in localization.available_languages -%}<button type="submit" name="locale_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}" role="option" aria-selected="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}"><span>{{ language.endonym_name | capitalize }}</span><small>{{ language.iso_code | upcase }}</small></button>{%- endfor -%}
          </div>
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</helix-store-header>

{% stylesheet %}
  .helix-skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 10px 14px;
    color: #fff;
    background: #323232;
    border-radius: 8px;
    opacity: 0;
    transform: translateY(-140%);
  }

  .helix-skip-link:focus {
    opacity: 1;
    transform: translateY(0);
  }

  .helix-header {
    position: relative;
    z-index: 55;
    display: block;
    width: 100%;
    height: 80px;
    color: var(--helix-header-text);
    font-family: var(--theme-body-font, 'Figtree', sans-serif);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.35;
  }

  .helix-header.is-transparent {
    margin-bottom: -80px;
  }

  .helix-header,
  .helix-header * {
    box-sizing: border-box;
  }

  .helix-header a {
    color: inherit;
    text-decoration: none;
  }

  .helix-header button,
  .helix-header input {
    color: inherit;
    font: inherit;
  }

  .helix-header button {
    cursor: pointer;
  }

  .helix-header ul,
  .helix-header ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .helix-header h2,
  .helix-header h3,
  .helix-header p {
    margin: 0;
    color: inherit;
    font: inherit;
    text-transform: none;
  }

  .helix-header__sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .helix-icon {
    display: block;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .helix-header__utility-divider {
    width: 1px;
    height: 16px;
    margin-inline: 10px;
    background: currentColor;
    opacity: .24;
  }

  .helix-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .helix-header__shell {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 80px;
    padding-inline: 30px;
    color: var(--helix-header-text);
    background: var(--helix-header-bg);
    border: 1px solid transparent;
    transition:
      top var(--helix-header-duration) ease,
      right var(--helix-header-duration) ease,
      left var(--helix-header-duration) ease,
      color var(--helix-header-duration) ease,
      background-color var(--helix-header-duration) ease,
      border-color var(--helix-header-duration) ease,
      border-radius var(--helix-header-duration) ease,
      box-shadow var(--helix-header-duration) ease,
      opacity var(--helix-header-duration) ease,
      transform var(--helix-header-duration) ease;
  }

  .helix-header.is-transparent:not(.is-scrolled):not(.has-open-menu) .helix-header__shell {
    color: var(--helix-header-transparent-text);
    background: transparent;
    border-color: transparent;
    text-shadow: 0 1px 14px rgb(0 0 0 / 28%);
  }

  .helix-header.is-transparent:not(.is-scrolled):not(.has-open-menu) .helix-icon {
    filter: drop-shadow(0 1px 5px rgb(0 0 0 / 26%));
  }

  .helix-header.is-scrolled .helix-header__shell {
    position: fixed;
    top: 16px;
    right: 30px;
    left: 30px;
    height: 80px;
    padding-inline: 30px;
    color: var(--helix-header-text);
    background: var(--helix-header-bg);
    border-color: var(--helix-header-border);
    border-radius: var(--helix-header-radius);
    box-shadow: 0 8px 28px rgb(16 24 40 / 8%);
    text-shadow: none;
  }

  .helix-header.has-open-menu .helix-header__shell {
    color: var(--helix-header-text);
    background: var(--helix-header-bg);
    border-color: var(--helix-header-border);
    text-shadow: none;
  }

  .helix-header.is-scrolled.has-open-menu .helix-header__shell {
    border-radius: var(--helix-header-radius) var(--helix-header-radius) 0 0;
    box-shadow: none;
  }

  .helix-header.has-open-menu .helix-icon,
  .helix-header.is-scrolled .helix-icon {
    filter: none;
  }

  .helix-header__desktop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    height: 100%;
  }

  .helix-header__mobile {
    display: none;
  }

  .helix-nav {
    position: static;
    display: flex;
    align-items: center;
    min-width: 0;
    height: 100%;
    gap: 0;
  }

  .helix-nav__item {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .helix-nav__item--mega {
    position: static;
  }

  .helix-nav__entry {
    position: relative;
    display: flex;
    align-items: center;
    height: 32px;
  }

  .helix-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 5px 12px;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 22.4px;
    white-space: nowrap;
  }

  .helix-nav__label {
    position: relative;
    display: inline-block;
  }

  .helix-nav__label::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: auto;
    width: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transition: width 200ms ease-in-out;
  }

  .helix-nav__link:hover .helix-nav__label::after,
  .helix-nav__link:focus-visible .helix-nav__label::after,
  .helix-nav__item.is-open .helix-nav__label::after {
    right: auto;
    left: 0;
    width: 100%;
  }

  .helix-nav__toggle {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    margin-left: -7px;
    border: 0;
    background: transparent;
  }

  .helix-nav__toggle .helix-icon {
    width: 16px;
    height: 16px;
    transition: transform 125ms ease;
  }

  .helix-nav__item.is-open .helix-nav__toggle .helix-icon {
    transform: scaleY(-1);
  }

  .helix-nav__panel {
    position: absolute;
    z-index: 4;
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    color: var(--helix-header-text);
    background: var(--helix-header-bg);
    border: 1px solid var(--helix-header-border);
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 300ms cubic-bezier(.6, .14, 0, 1),
      opacity 200ms cubic-bezier(.6, .14, 0, 1),
      visibility 0s linear 300ms;
  }

  .helix-nav__panel > * {
    min-height: 0;
  }

  .helix-nav__panel--mega {
    top: 100%;
    right: 0;
    left: 0;
    border-width: 1px 0 0;
    border-radius: 0 0 var(--helix-header-radius) var(--helix-header-radius);
  }

  .helix-nav__panel--dropdown {
    top: calc(100% - 2px);
    left: 0;
    width: 250px;
    border-radius: 12px;
    box-shadow: 0 18px 44px rgb(16 24 40 / 12%);
  }

  .helix-header.is-scrolled .helix-nav__panel--mega {
    top: 100%;
    border-width: 1px;
    border-radius: 0 0 var(--helix-header-radius) var(--helix-header-radius);
    box-shadow: 0 18px 44px rgb(16 24 40 / 12%);
  }

  .helix-header.is-scrolled .helix-nav__panel--dropdown {
    top: calc(100% - 2px);
  }

  .helix-nav__item.is-open .helix-nav__panel {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .helix-dropdown-menu {
    display: grid;
    gap: 2px;
    padding: 12px;
  }

  .helix-mega > *,
  .helix-dropdown-menu > li {
    opacity: 0;
  }

  .helix-mega > * {
    transform: translateY(15px);
  }

  .helix-dropdown-menu > li {
    transform: translateX(15px);
  }

  .helix-nav__item.is-open .helix-mega > * {
    animation: helix-mega-item-in 400ms ease both;
  }

  .helix-nav__item.is-open .helix-dropdown-menu > li {
    animation: helix-menu-item-in 400ms ease both;
  }

  .helix-nav__item.is-open .helix-mega > :nth-child(1) { animation-delay: 200ms; }
  .helix-nav__item.is-open .helix-mega > :nth-child(2) { animation-delay: 250ms; }
  .helix-nav__item.is-open .helix-mega > :nth-child(3) { animation-delay: 300ms; }
  .helix-nav__item.is-open .helix-mega > :nth-child(4) { animation-delay: 350ms; }
  .helix-nav__item.is-open .helix-mega > :nth-child(5) { animation-delay: 400ms; }

  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(1) { animation-delay: 150ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(2) { animation-delay: 200ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(3) { animation-delay: 250ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(4) { animation-delay: 300ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(5) { animation-delay: 350ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(6) { animation-delay: 400ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(7) { animation-delay: 450ms; }
  .helix-nav__item.is-open .helix-dropdown-menu > li:nth-child(8) { animation-delay: 500ms; }

  @keyframes helix-mega-item-in {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes helix-menu-item-in {
    from {
      opacity: 0;
      transform: translateX(15px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .helix-dropdown-menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 8px;
  }

  .helix-dropdown-menu a:hover,
  .helix-dropdown-menu a:focus-visible {
    background: rgb(50 50 50 / 6%);
  }

  .helix-mega {
    display: grid;
    grid-template-columns: minmax(120px, .7fr) repeat(2, minmax(120px, .8fr)) minmax(350px, 2.2fr);
    gap: 24px;
    max-height: min(560px, calc(100vh - 130px));
    padding: 30px;
    overflow-y: auto;
  }

  .helix-mega__featured {
    grid-column: 1;
  }

  .helix-mega__group-title {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .helix-mega__group-title {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: .02em;
    line-height: 22.4px;
  }

  .helix-mega__featured ul,
  .helix-mega__group ul {
    display: grid;
    gap: 10px;
  }

  .helix-mega__featured li a,
  .helix-mega__group li a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    font-size: 14px;
    line-height: 22.4px;
    color: color-mix(in srgb, var(--helix-header-text) 82%, transparent);
  }

  .helix-mega__featured li a {
    color: var(--helix-header-text);
    font-family: var(--theme-heading-font, 'Archivo', sans-serif);
    font-size: 16px;
    font-weight: 700;
    line-height: 25.6px;
  }

  .helix-mega__group li a {
    font-weight: 400;
  }

  .helix-mega__featured li a::after,
  .helix-mega__group li a::after {
    position: absolute;
    bottom: 6px;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .helix-mega__featured li a:hover::after,
  .helix-mega__featured li a:focus-visible::after,
  .helix-mega__group li a:hover::after,
  .helix-mega__group li a:focus-visible::after {
    transform: scaleX(1);
  }

  .helix-mega__promos,
  .helix-mega__products-wrap {
    grid-column: 4;
  }

  .helix-mega__promos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .helix-mega__promo {
    min-width: 0;
    overflow: hidden;
    background: #eef0eb;
    border-radius: 12px;
  }

  .helix-mega__promo > a {
    position: relative;
    display: block;
    height: 100%;
    min-height: 250px;
  }

  .helix-mega__promo-media {
    position: absolute;
    inset: 0;
    display: block;
    background: linear-gradient(145deg, #dadfd1, #a9b5a1);
  }

  .helix-mega__promo-media::after {
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 58%));
    content: '';
  }

  .helix-mega__promo-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .helix-mega__promo:hover img {
    transform: scale(1.035);
  }

  .helix-mega__promo-copy {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    z-index: 1;
    display: grid;
    gap: 6px;
    color: #fff;
  }

  .helix-mega__promo-copy > span {
    font-family: var(--theme-heading-font, 'Archivo', sans-serif);
    font-size: 20px;
    font-weight: 700;
  }

  .helix-mega__promo-copy strong {
