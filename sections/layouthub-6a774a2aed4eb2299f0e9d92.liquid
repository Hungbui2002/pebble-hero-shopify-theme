<section id="" data-section-id="ulkeafuwyg" data-section="services-284" data-dev="hongyen" data-lh-page-id="1073" data-lh-page-name="Xmas - Landing" data-layouthub="section">  
 <!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kartograf - Richiesta Preventivo</title>

<link rel="stylesheet" href="style.css">
</head>
<body>

<section class="kg-builder">

    <div class="kg-container">

        <!-- HERO -->

        <div class="kg-header">

            <span class="kg-badge">
                CONSULENTE DIGITALE KARTOGRAF
            </span>

            <h1>
                RACCONTACI IL TUO PROGETTO
            </h1>

            <p>
                Configura la tua richiesta e ricevi un preventivo personalizzato.
            </p>

        </div>

        <!-- LAYOUT -->

        <div class="kg-layout">

            <!-- LEFT -->

            <div class="kg-form-area">

                <!-- CATEGORIE -->

                <div class="kg-tabs">

                    <button
                        class="kg-tab active"
                        data-target="cartaceo">

                        Materiale Cartaceo

                    </button>

                    <button
                        class="kg-tab"
                        data-target="adesivi">

                        Adesivi

                    </button>

                    <button
                        class="kg-tab"
                        data-target="insegne">

                        Insegne

                    </button>

                    <button
                        class="kg-tab"
                        data-target="abbigliamento">

                        Abbigliamento

                    </button>

                </div>

                <!-- PANEL CARTACEO -->

                <div
                    class="kg-panel active"
                    id="cartaceo">

                    <h2>
                        Materiale Cartaceo
                    </h2>

                    <div class="kg-grid">

                        <div class="kg-field">

                            <label>
                                Tipo prodotto
                            </label>

                            <select data-label="Tipo prodotto">

                                <option>Biglietto da visita</option>
                                <option>Volantino</option>
                                <option>Flyer</option>
                                <option>Brochure</option>
                                <option>Pieghevole</option>

                            </select>

                        </div>

                        <div class="kg-field">

                            <label>
                                Quantità
                            </label>

                            <input
                                type="number"
                                data-label="Quantità">

                        </div>

                        <div class="kg-field">

                            <label>
                                Formato
                            </label>

                            <select data-label="Formato">

                                <option>A6</option>
                                <option>A5</option>
                                <option>A4</option>
                                <option>A3</option>

                            </select>

                        </div>

                        <div class="kg-field">

                            <label>
                                Grammatura
                            </label>

                            <select data-label="Grammatura">

                                <option>135g</option>
                                <option>170g</option>
                                <option>250g</option>
                                <option>300g</option>
                                <option>350g</option>

                            </select>

                        </div>

                    </div>

                </div>

                <!-- PANEL ADESIVI -->

                <div
                    class="kg-panel"
                    id="adesivi">

                    <h2>
                        Adesivi e Vetrofanie
                    </h2>

                    <div class="kg-grid">

                        <div class="kg-field">

                            <label>
                                Tipologia
                            </label>

                            <select data-label="Tipologia">

                                <option>Monomerico</option>
                                <option>Polimerico</option>
                                <option>One Way</option>
                                <option>Vetrofania</option>

                            </select>

                        </div>

                        <div class="kg-field">

                            <label>
                                Larghezza
                            </label>

                            <input
                                type="number"
                                data-label="Larghezza">

                        </div>

                        <div class="kg-field">

                            <label>
                                Altezza
                            </label>

                            <input
                                type="number"
                                data-label="Altezza">

                        </div>

                        <div class="kg-field">

                            <label>
                                Laminazione
                            </label>

                            <select data-label="Laminazione">

                                <option>Nessuna</option>
                                <option>Lucida</option>
                                <option>Opaca</option>

                            </select>

                        </div>

                    </div>

                </div>

                <!-- PANEL INSEGNE -->

                <div
                    class="kg-panel"
                    id="insegne">

                    <h2>
                        Insegne
                    </h2>

                    <div class="kg-grid">

                        <div class="kg-field">

                            <label>
                                Tipologia
                            </label>

                            <select data-label="Tipologia Insegna">

                                <option>Dibond</option>
                                <option>Forex</option>
                                <option>Plexiglass</option>
                                <option>Cassonetto luminoso</option>

                            </select>

                        </div>

                        <div class="kg-field">

                            <label>
                                Dimensioni
                            </label>

                            <input
                                type="text"
                                data-label="Dimensioni">

                        </div>

                        <div class="kg-field">

                            <label>
                                Illuminazione
                            </label>

                            <select data-label="Illuminazione">

                                <option>Nessuna</option>
                                <option>LED Frontale</option>
                                <option>LED Retroilluminato</option>

                            </select>

                        </div>

                    </div>

                </div>

                <!-- PANEL ABBIGLIAMENTO -->

                <div
                    class="kg-panel"
                    id="abbigliamento">

                    <h2>
                        Abbigliamento Personalizzato
                    </h2>

                    <div class="kg-grid">

                        <div class="kg-field">

                            <label>
                                Prodotto
                            </label>

                            <select data-label="Prodotto">

                                <option>T-Shirt</option>
                                <option>Polo</option>
                                <option>Felpa</option>

                            </select>

                        </div>

                        <div class="kg-field">

                            <label>
                                Quantità
                            </label>

                            <input
                                type="number"
                                data-label="Quantità">

                        </div>

                        <div class="kg-field">

                            <label>
                                Posizione stampa
                            </label>

                            <select data-label="Posizione stampa">

                                <option>Petto</option>
                                <option>Schiena</option>
                                <option>Petto + Schiena</option>

                            </select>

                        </div>

                    </div>

                </div>

                <!-- DESCRIZIONE -->

                <div class="kg-card">

                    <h2>
                        Descrizione progetto
                    </h2>

                    <textarea
                        id="project-description"
                        data-label="Descrizione progetto"
                        rows="6"></textarea>

                </div>

                <!-- DATI -->

                <div class="kg-card">

                    <h2>
                        Dati Cliente
                    </h2>

                    <div class="kg-grid">

                        <div class="kg-field">

                            <label>
                                Nome
                            </label>

                            <input
                                type="text"
                                id="customer-name">

                        </div>

                        <div class="kg-field">

                            <label>
                                Email
                            </label>

                            <input
                                type="email"
                                id="customer-email">

                        </div>

                    </div>

                </div>

                <!-- CTA -->

                <a
                    href="#"
                    id="generate-mail"
                    class="kg-btn">

                    PREPARA RICHIESTA PREVENTIVO

                    <span class="arrow">→</span>

                </a>

            </div>

            <!-- RIGHT -->

            <div class="kg-summary">

