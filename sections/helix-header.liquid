    font-size: 13px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .helix-mega-product__price {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
  }

  .helix-mega-product__price strong {
    color: #d91818;
    font-weight: 400;
  }

  .helix-mega-product__price s {
    color: #777;
  }

  .helix-mega-product form button {
    min-height: 36px;
    padding: 7px 10px;
    border: 1px solid var(--helix-header-text);
    color: var(--helix-header-text);
    background: transparent;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
  }

  .helix-mega-product form button:hover,
  .helix-mega-product form button:focus-visible {
    color: var(--helix-header-bg);
    background: var(--helix-header-text);
  }

  .helix-header__logo {
    position: relative;
    z-index: 3;
    display: grid;
    place-items: center;
    width: var(--helix-logo-width);
    min-height: 32px;
    line-height: 1;
  }

  .helix-header__logo-image {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
  }

  .helix-header__logo-image img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 42px;
    object-fit: contain;
  }

  .helix-header__logo-image--transparent {
    opacity: 0;
    visibility: hidden;
  }

  .helix-header.is-transparent:not(.is-scrolled):not(.has-open-menu) .has-transparent-logo .helix-header__logo-image--default {
    opacity: 0;
    visibility: hidden;
  }

  .helix-header.is-transparent:not(.is-scrolled):not(.has-open-menu) .has-transparent-logo .helix-header__logo-image--transparent {
    opacity: 1;
    visibility: visible;
  }

  .helix-header__wordmark {
    overflow: hidden;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: .09em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .helix-header__fallback-logo {
    display: block;
    width: 100%;
    height: auto;
    max-height: 42px;
    object-fit: contain;
    transition: filter var(--helix-header-duration) ease;
  }

  .helix-header.is-transparent:not(.is-scrolled):not(.has-open-menu) .helix-header__fallback-logo {
    filter: brightness(0) invert(1);
  }

  .helix-header__utilities,
  .helix-header__mobile-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    gap: 0;
  }

  .helix-header__utility {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    color: inherit;
    background: transparent;
    border-radius: 50%;
  }

  .helix-header__utility:hover {
    background: color-mix(in srgb, currentColor 9%, transparent);
  }

  .helix-header__cart-count {
    position: absolute;
    top: 2px;
    right: 0;
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    color: #fff;
    background: #323232;
    border-radius: 999px;
    font-size: 10px;
    line-height: 1;
  }

  .helix-header.is-transparent:not(.is-scrolled):not(.has-open-menu) .helix-header__cart-count {
    color: #323232;
    background: #fff;
  }

  .helix-localization--desktop {
    position: relative;
  }

  .helix-localization details {
    position: relative;
  }

  .helix-localization summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 7px;
    padding: 0 8px;
    list-style: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .helix-localization summary::-webkit-details-marker {
    display: none;
  }

  .helix-localization summary .helix-icon {
    width: 15px;
    height: 15px;
    transition: transform 125ms ease;
  }

  .helix-localization details[open] summary .helix-icon {
    transform: scaleY(-1);
  }

  .helix-localization__popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 7;
    display: grid;
    width: 360px;
    max-height: min(540px, calc(100vh - 120px));
    padding: 16px;
    overflow: hidden;
    color: var(--helix-header-text);
    background: var(--helix-header-bg);
    border: 1px solid var(--helix-header-border);
    border-radius: 14px;
    box-shadow: 0 18px 44px rgb(16 24 40 / 14%);
  }

  .helix-localization__search {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: center;
    min-height: 48px;
    padding-inline: 12px;
    color: var(--helix-header-text);
    background: #f5f5f5;
    border: 1px solid #e4e4e4;
    border-radius: 10px;
  }

  .helix-localization__search .helix-icon {
    width: 19px;
    height: 19px;
  }

  .helix-localization__search input {
    width: 100%;
    min-width: 0;
    height: 46px;
    padding: 0 8px;
    border: 0;
    outline: 0;
    color: var(--helix-header-text);
    background: transparent;
  }

  .helix-localization__list {
    display: grid;
    max-height: 330px;
    margin-top: 10px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .helix-localization__list button,
  .helix-localization__languages button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    padding: 8px 10px;
    border: 0;
    color: var(--helix-header-text);
    background: transparent;
    border-radius: 8px;
    text-align: left;
  }

  .helix-localization__list button:hover,
  .helix-localization__list button:focus-visible,
  .helix-localization__languages button:hover,
  .helix-localization__languages button:focus-visible,
  .helix-localization__list button[aria-selected='true'],
  .helix-localization__languages button[aria-current='true'] {
    background: #f1f1f1;
  }

  .helix-localization__list small,
  .helix-localization__languages small {
    color: #6a6a6a;
    font-size: 12px;
  }

  .helix-localization__label {
    padding: 14px 10px 6px;
    border-top: 1px solid var(--helix-header-border);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .helix-localization__languages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .helix-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 700ms ease, visibility 0s linear 700ms;
  }

  .helix-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .helix-overlay__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 50%);
  }

  .helix-overlay--sheet .helix-overlay__backdrop {
    background: rgb(0 0 0 / 30%);
  }

  .helix-overlay__panel {
    position: absolute;
    color: var(--helix-header-text);
    background: var(--helix-header-bg);
    box-shadow: 0 24px 70px rgb(0 0 0 / 18%);
    transition: transform var(--helix-header-duration) cubic-bezier(.22, 1, .36, 1);
  }

  .helix-overlay__panel--right {
    top: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    width: min(550px, calc(100vw - 32px));
    overflow: hidden;
    border-radius: 16px;
    transform: translateX(calc(100% + 32px));
  }

  .helix-overlay.is-open .helix-overlay__panel--right {
    transform: translateX(0);
  }

  .helix-overlay__panel--left {
    top: 8px;
    bottom: 8px;
    left: 8px;
    width: min(430px, calc(100vw - 16px));
    overflow: hidden;
    border-radius: 16px;
    transform: translateX(calc(-100% - 16px));
  }

  .helix-overlay.is-open .helix-overlay__panel--left {
    transform: translateX(0);
  }

  .helix-overlay__panel--sheet {
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    max-height: 70svh;
    overflow: hidden;
    border-radius: 16px 16px 0 0;
    transform: translateY(100%);
  }

  .helix-overlay.is-open .helix-overlay__panel--sheet {
    transform: translateY(0);
  }

  .helix-drawer__header {
    display: flex;
    align-items: center;
    flex: 0 0 72px;
    min-height: 72px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--helix-header-border);
    gap: 8px;
  }

  .helix-drawer__header h2,
  .helix-drawer__header strong {
    flex: 1;
    font-size: 18px;
    font-weight: 650;
  }

  .helix-drawer__header button {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 50%;
  }

  .helix-drawer__header button:hover {
    background: #f2f2f2;
  }

  .helix-drawer__body {
    flex: 1;
    min-height: 0;
    padding: 28px 30px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .helix-search {
    display: grid;
    gap: 10px;
  }

  .helix-search > label,
  .helix-popular-searches h3,
  .helix-predictive__group h3 {
    font-size: 13px;
    font-weight: 650;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .helix-search__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 52px;
    min-height: 54px;
    overflow: hidden;
    border: 1px solid #d8d8d8;
    border-radius: 12px;
  }

  .helix-search__field:focus-within {
    border-color: var(--helix-header-text);
    box-shadow: 0 0 0 1px var(--helix-header-text);
  }

  .helix-search__field input {
    width: 100%;
    min-width: 0;
    padding: 0 16px;
    border: 0;
    outline: 0;
    color: var(--helix-header-text);
    background: transparent;
  }

  .helix-search__field button {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    color: #fff;
    background: var(--helix-header-text);
  }

  .helix-popular-searches {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }

  .helix-popular-searches > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .helix-popular-searches a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 14px;
    background: #f2f2f2;
    border-radius: 999px;
  }

  .helix-predictive {
    display: grid;
    gap: 24px;
    margin-top: 28px;
  }

  .helix-predictive:empty {
    display: none;
  }

  .helix-predictive__group {
    display: grid;
    gap: 12px;
  }

  .helix-predictive__products,
  .helix-predictive__links {
    display: grid;
    gap: 4px;
  }

  .helix-predictive__product {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    min-height: 76px;
    padding: 6px;
    gap: 12px;
    border-radius: 10px;
  }

  .helix-predictive__product:hover,
  .helix-predictive__product:focus-visible,
  .helix-predictive__links a:hover,
  .helix-predictive__links a:focus-visible {
    background: #f4f4f4;
  }

  .helix-predictive__media {
    display: block;
    overflow: hidden;
    width: 64px;
    height: 64px;
    background: #f2f2f2;
    border-radius: 8px;
  }

  .helix-predictive__media img,
  .helix-predictive__media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .helix-predictive__copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .helix-predictive__copy > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .helix-predictive__copy strong {
    font-size: 13px;
    font-weight: 600;
  }

  .helix-predictive__links a,
  .helix-predictive__view-all {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 10px;
    border-radius: 8px;
  }

  .helix-predictive__view-all {
    justify-content: center;
    border: 1px solid var(--helix-header-text);
    font-weight: 600;
  }

  .helix-predictive__empty {
    padding-block: 10px;
    color: #666;
  }

  .helix-cart {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .helix-cart__items {
    flex: 1;
    min-height: 0;
    padding: 20px 30px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .helix-cart-item {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 14px;
    padding-block: 14px;
    border-bottom: 1px solid var(--helix-header-border);
  }

  .helix-cart-item__image {
    display: block;
    overflow: hidden;
    width: 84px;
    aspect-ratio: 1;
    background: #f2f2f2;
    border-radius: 10px;
  }

  .helix-cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .helix-cart-item > div {
    display: grid;
    align-content: start;
    gap: 5px;
    min-width: 0;
  }

  .helix-cart-item > div > a {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .helix-cart-item small,
  .helix-cart-item span {
    color: #6a6a6a;
    font-size: 12px;
  }

  .helix-cart-item strong {
    font-weight: 600;
  }

  .helix-cart__empty {
    flex: 1;
    padding: 48px 30px;
    overflow-y: auto;
  }

  .helix-cart__empty h3 {
    font-size: 24px;
    font-weight: 650;
  }

  .helix-cart__empty > p {
    margin-top: 8px;
    color: #666;
  }

  .helix-cart__suggestions {
    display: grid;
    gap: 8px;
    margin-top: 28px;
  }

  .helix-cart__suggestions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 10px 14px;
    background: #f3f3f3;
    border-radius: 10px;
  }

  .helix-cart__suggestions .helix-icon {
    width: 18px;
    height: 18px;
  }

  .helix-cart__footer {
    display: grid;
    flex: 0 0 auto;
    gap: 10px;
    padding: 20px 30px 24px;
    border-top: 1px solid var(--helix-header-border);
  }

  .helix-cart__footer p {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .helix-cart__footer > a,
  .helix-cart__footer button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 50px;
    border: 1px solid var(--helix-header-text);
    border-radius: 999px;
    font-weight: 600;
  }

  .helix-cart__footer button {
    color: #fff;
    background: var(--helix-header-text);
  }

  .helix-cart__footer > a {
    color: var(--helix-header-text);
    background: transparent;
  }

  .helix-localization--sheet {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    padding: 16px 20px 20px;
  }

  .helix-localization--sheet .helix-localization__list {
    flex: 1;
    max-height: none;
    min-height: 0;
  }

  .helix-mobile-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--helix-header-bg);
    opacity: 0;
    visibility: hidden;
    transform: translateX(100%);
    transition: transform 300ms ease, opacity 200ms ease, visibility 0s linear 300ms;
  }

  .helix-mobile-panel.is-active {
    z-index: 2;
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition-delay: 0s;
  }

  .helix-mobile-panel.is-before {
    opacity: 0;
    visibility: hidden;
    transform: translateX(-100%);
  }

  .helix-mobile-nav {
    flex: 1;
    min-height: 0;
    padding: 16px 20px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .helix-mobile-nav__row {
    display: flex;
    align-items: center;
    min-height: 54px;
    border-bottom: 1px solid var(--helix-header-border);
  }

  .helix-mobile-nav__row > a {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    min-height: 54px;
    font-size: 18px;
  }

  .helix-mobile-nav__row > button {
    display: grid;
    place-items: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    border-radius: 50%;
  }

  .helix-icon--right {
    transform: rotate(-90deg);
  }

  .helix-mobile-nav__view-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    padding: 0 12px;
    margin-bottom: 12px;
    color: #fff !important;
    background: var(--helix-header-text);
    border-radius: 10px;
    font-weight: 600;
  }

  .helix-mobile-nav__view-all .helix-icon {
    width: 18px;
    height: 18px;
  }

  .helix-mobile-nav__utilities {
    display: grid;
    gap: 2px;
    margin-top: 26px;
    padding-top: 14px;
    border-top: 1px solid var(--helix-header-border);
  }

  .helix-mobile-nav__utilities > a,
  .helix-mobile-nav__utilities > button {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 52px;
    padding: 6px 4px;
    gap: 12px;
    border: 0;
    background: transparent;
    text-align: left;
  }

  .helix-mobile-nav__utilities > button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .helix-mobile-nav__utilities small {
    color: #6a6a6a;
    font-size: 12px;
    text-align: right;
  }

  .helix-header :is(a, button, summary, input):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  body.helix-scroll-locked {
    position: fixed;
    width: 100%;
    overflow: hidden;
  }

  .helix-header [hidden] {
    display: none !important;
  }

  @media (min-width: 1280px) {
    .helix-header__shell {
      padding-inline: 50px;
    }

    .helix-header.is-scrolled .helix-header__shell {
      right: 50px;
      left: 50px;
      padding-inline: 30px;
    }

    .helix-mega {
      padding-inline: 30px;
    }
  }

  @media (max-width: 1120px) and (min-width: 991px) {
    .helix-nav {
      gap: 0;
    }

    .helix-nav__link {
      padding-inline: 5px;
      font-size: 13px;
    }

    .helix-nav__link::after {
      right: 5px;
      left: 5px;
    }

    .helix-nav__toggle {
      width: 26px;
      margin-left: -5px;
    }

    .helix-header__utilities {
      gap: 0;
    }

    .helix-header__utility {
      flex-basis: 42px;
      width: 42px;
    }

    .helix-mega {
      grid-template-columns: minmax(110px, .7fr) repeat(2, minmax(110px, .8fr)) minmax(330px, 2fr);
      gap: 18px;
      padding: 24px 20px;
    }
  }

  @media (max-width: 990px) {
    .helix-header {
      height: 56px;
    }

    .helix-header.is-transparent {
      margin-bottom: -56px;
    }

    .helix-header__shell,
    .helix-header.is-scrolled .helix-header__shell {
      right: 0;
      left: 0;
      height: 56px;
      padding-inline: 30px;
      border-radius: 0;
    }

    .helix-header.is-scrolled .helix-header__shell {
      top: 0;
      border-width: 0 0 1px;
      box-shadow: 0 4px 18px rgb(16 24 40 / 8%);
    }

    .helix-header.is-mobile-hidden .helix-header__shell {
      transform: translateY(-110%);
    }

    .helix-header__desktop {
      display: none;
    }

    .helix-header__mobile {
      display: grid;
      grid-template-columns: minmax(88px, 1fr) auto minmax(88px, 1fr);
      align-items: center;
      width: 100%;
      height: 100%;
    }

    .helix-header__mobile > .helix-header__utility {
      justify-self: start;
    }

    .helix-header__mobile-actions {
      justify-self: end;
      gap: 4px;
    }

    .helix-header__utility {
      flex-basis: 40px;
      width: 40px;
      height: 40px;
      padding: 8px;
    }

    .helix-header__logo {
      width: var(--helix-mobile-logo-width);
    }

    .helix-header__wordmark {
      font-size: 22px;
    }

    .helix-header__logo-image img {
      max-height: 32px;
    }

    .helix-header__fallback-logo {
      max-height: 32px;
    }

    .helix-overlay__panel--right {
      top: 8px;
      right: 8px;
      bottom: 8px;
      width: calc(100vw - 16px);
      border-radius: 16px;
      transform: translateX(calc(100% + 16px));
    }

    .helix-drawer__header {
      flex-basis: 64px;
      min-height: 64px;
      padding: 10px 16px;
    }

    .helix-drawer__body,
    .helix-cart__items,
    .helix-cart__empty {
      padding-inline: 20px;
    }

    .helix-cart__footer {
      padding-inline: 20px;
    }

    .helix-localization__popover {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .helix-header__shell,
    .helix-nav__panel,
    .helix-mega > *,
    .helix-dropdown-menu > li,
    .helix-nav__toggle .helix-icon,
    .helix-overlay,
    .helix-overlay__panel,
    .helix-mobile-panel,
    .helix-mega__promo-media img {
      scroll-behavior: auto;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
      animation-delay: 0s !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('helix-store-header')) {
    customElements.define('helix-store-header', class extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;
        this.desktopQuery = window.matchMedia('(min-width: 991px)');
        this.hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.stickyDesktop = this.dataset.stickyDesktop === 'true';
        this.stickyMobile = this.dataset.stickyMobile === 'true';
        this.lastScroll = Math.max(0, window.scrollY);
        this.menuOpenTimer = null;
        this.pendingMenuItem = null;
        this.menuCloseTimer = null;
        this.menuItems = Array.from(this.querySelectorAll('[data-menu-item]'));
        this.overlays = new Map(Array.from(this.querySelectorAll('[data-overlay]')).map((overlay) => [overlay.dataset.overlay, overlay]));
        this.boundScroll = () => this.requestScrollUpdate();
        this.boundKeydown = (event) => this.handleKeydown(event);
        this.boundPointerdown = (event) => this.handlePointerdown(event);
        this.boundCartRefresh = () => this.refreshCart();
        this.setupMenus();
        this.setupOverlays();
        this.setupMobilePanels();
        this.setupLocalization();
        this.setupPredictiveSearch();
        this.setupCart();
        this.setupProductCarousels();
        window.addEventListener('scroll', this.boundScroll, { passive: true });
        document.addEventListener('keydown', this.boundKeydown);
        document.addEventListener('pointerdown', this.boundPointerdown);
        document.addEventListener('cart:refresh', this.boundCartRefresh);
        document.addEventListener('cart:updated', this.boundCartRefresh);
        this.updateScrollState();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.boundScroll);
        document.removeEventListener('keydown', this.boundKeydown);
        document.removeEventListener('pointerdown', this.boundPointerdown);
        document.removeEventListener('cart:refresh', this.boundCartRefresh);
        document.removeEventListener('cart:updated', this.boundCartRefresh);
        this.predictiveController?.abort();
        this.cancelMenuOpen();
        this.cancelMenuClose();
        if (this.scrollLocked) this.unlockScroll();
      }

      setupMenus() {
        this.menuItems.forEach((item) => {
          const toggle = item.querySelector('[data-menu-toggle]');
          const link = item.querySelector('[data-touch-menu-link]');
          toggle?.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            if (item.classList.contains('is-open')) this.closeMenus();
            else this.openMenu(item);
          });
          link?.addEventListener('click', (event) => {
            if (this.hoverQuery.matches || item.classList.contains('is-open')) return;
            event.preventDefault();
            this.openMenu(item);
          });
          item.addEventListener('mouseenter', () => {
            this.cancelMenuClose();
            if (this.hoverQuery.matches && this.desktopQuery.matches) this.scheduleMenuOpen(item);
          });
          item.addEventListener('mouseleave', () => {
            if (!this.hoverQuery.matches || !this.desktopQuery.matches) return;
            if (this.pendingMenuItem === item) this.cancelMenuOpen();
            this.scheduleMenuClose();
          });
          item.addEventListener('focusin', () => {
            if (this.desktopQuery.matches) this.openMenu(item);
          });
          item.addEventListener('focusout', () => {
            window.setTimeout(() => {
              const hoveredItem = this.menuItems.some((menuItem) => menuItem.matches(':hover'));
              const focusedItem = this.menuItems.some((menuItem) => menuItem.contains(document.activeElement));
              if (!hoveredItem && !focusedItem) this.closeMenus();
            }, 0);
          });
        });
      }

      cancelMenuClose() {
        window.clearTimeout(this.menuCloseTimer);
        this.menuCloseTimer = null;
      }

      cancelMenuOpen() {
        window.clearTimeout(this.menuOpenTimer);
        this.menuOpenTimer = null;
        this.pendingMenuItem = null;
      }

      scheduleMenuOpen(item) {
        if (item.classList.contains('is-open') || this.pendingMenuItem === item) return;
        this.cancelMenuOpen();
        this.pendingMenuItem = item;
        this.menuOpenTimer = window.setTimeout(() => {
          this.menuOpenTimer = null;
          this.pendingMenuItem = null;
          if (item.matches(':hover')) this.openMenu(item);
        }, 120);
      }

      scheduleMenuClose() {
        this.cancelMenuClose();
        this.menuCloseTimer = window.setTimeout(() => {
          this.menuCloseTimer = null;
          const hoveredItem = this.menuItems.some((menuItem) => menuItem.matches(':hover'));
          const focusedItem = this.menuItems.some((menuItem) => menuItem.contains(document.activeElement));
          if (!hoveredItem && !focusedItem) this.closeMenus();
        }, 80);
      }

      openMenu(item) {
        this.cancelMenuOpen();
        this.cancelMenuClose();
        this.closeMenus(item);
        item.classList.add('is-open');
        item.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', 'true');
        this.syncHeaderChrome();
      }

      closeMenus(except) {
        if (!except) this.cancelMenuOpen();
        this.cancelMenuClose();
        this.menuItems.forEach((item) => {
          if (item === except) return;
          item.classList.remove('is-open');
          item.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', 'false');
        });
        this.syncHeaderChrome();
      }

      syncHeaderChrome() {
        const menuOpen = this.menuItems.some((item) => item.classList.contains('is-open'));
        const localizationOpen = Array.from(this.querySelectorAll('[data-desktop-localization]')).some((details) => details.open);
        this.classList.toggle('has-open-menu', menuOpen || localizationOpen);
      }

      setupOverlays() {
        this.querySelectorAll('[data-overlay-open]').forEach((trigger) => {
          trigger.addEventListener('click', (event) => {
            const name = trigger.dataset.overlayOpen;
            if (!this.overlays.has(name)) return;
            event.preventDefault();
            this.openOverlay(name, trigger);
          });
        });
        this.overlays.forEach((overlay) => {
          overlay.querySelectorAll('[data-overlay-close], [data-overlay-backdrop]').forEach((control) => {
            control.addEventListener('click', () => this.closeOverlay(true, true));
          });
        });
      }

      openOverlay(name, trigger) {
        const overlay = this.overlays.get(name);
        if (!overlay) return;
        this.closeMenus();
        this.querySelectorAll('[data-desktop-localization][open]').forEach((details) => details.removeAttribute('open'));
        if (this.activeOverlay && this.activeOverlay !== overlay) this.closeOverlay(false, false);
        this.activeOverlay = overlay;
        this.activeTrigger = trigger;
        if (!this.scrollLocked) this.lockScroll();
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        trigger?.setAttribute('aria-expanded', 'true');
        if (name === 'menu') this.resetMobilePanels();
        if (name === 'cart') this.refreshCart();
        window.setTimeout(() => {
          const focusTarget = overlay.querySelector('[data-overlay-autofocus]') || this.getFocusable(overlay)[0];
          focusTarget?.focus({ preventScroll: true });
        }, this.reducedMotion ? 0 : 60);
      }

      closeOverlay(restoreFocus = true, unlock = true) {
        if (!this.activeOverlay) return;
        const overlay = this.activeOverlay;
        const trigger = this.activeTrigger;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        trigger?.setAttribute('aria-expanded', 'false');
        this.activeOverlay = null;
        this.activeTrigger = null;
        if (unlock) this.unlockScroll();
        if (restoreFocus && trigger?.isConnected) {
          window.setTimeout(() => trigger.focus({ preventScroll: true }), 0);
        }
      }

      lockScroll() {
        this.lockedScrollPosition = Math.max(0, window.scrollY);
        document.body.style.top = `-${this.lockedScrollPosition}px`;
        document.body.classList.add('helix-scroll-locked');
        this.scrollLocked = true;
      }

      unlockScroll() {
        if (!this.scrollLocked) return;
        document.body.classList.remove('helix-scroll-locked');
        document.body.style.top = '';
        window.scrollTo(0, this.lockedScrollPosition || 0);
        this.scrollLocked = false;
      }

      getFocusable(container) {
        return Array.from(container.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), summary, [tabindex]:not([tabindex="-1"])')).filter((element) => !element.hidden && element.getClientRects().length > 0 && !element.closest('[inert]'));
      }

      handleKeydown(event) {
        if (event.key === 'Escape') {
          if (this.activeOverlay) {
            event.preventDefault();
            this.closeOverlay(true, true);
            return;
          }
          const openToggle = this.querySelector('.helix-nav__item.is-open [data-menu-toggle]');
          this.closeMenus();
          this.querySelectorAll('[data-desktop-localization][open]').forEach((details) => details.removeAttribute('open'));
          openToggle?.focus();
          return;
        }
        if (event.key !== 'Tab' || !this.activeOverlay) return;
        const focusable = this.getFocusable(this.activeOverlay);
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }

      handlePointerdown(event) {
        const shell = this.querySelector('[data-header-shell]');
        if (shell && !shell.contains(event.target)) {
          this.closeMenus();
          this.querySelectorAll('[data-desktop-localization][open]').forEach((details) => details.removeAttribute('open'));
        }
      }

      setupMobilePanels() {
        this.querySelectorAll('[data-panel-target]').forEach((button) => {
          button.addEventListener('click', () => this.activateMobilePanel(button.dataset.panelTarget, false));
        });
        this.querySelectorAll('[data-panel-back]').forEach((button) => {
          button.addEventListener('click', () => this.activateMobilePanel(button.dataset.panelBack, true));
        });
        this.resetMobilePanels();
      }

      resetMobilePanels() {
        const panels = Array.from(this.querySelectorAll('[data-mobile-panel]'));
        panels.forEach((panel) => {
          const active = panel.dataset.mobilePanel === 'root';
          panel.classList.toggle('is-active', active);
          panel.classList.remove('is-before');
          panel.inert = !active;
        });
      }

      activateMobilePanel(name, back) {
        const panels = Array.from(this.querySelectorAll('[data-mobile-panel]'));
        const current = panels.find((panel) => panel.classList.contains('is-active'));
        const next = panels.find((panel) => panel.dataset.mobilePanel === name);
        if (!next || next === current) return;
        current?.classList.remove('is-active');
        current?.classList.toggle('is-before', !back);
        if (current) current.inert = true;
        next.classList.remove('is-before');
        next.classList.add('is-active');
        next.inert = false;
        const focusTarget = next.querySelector('[data-panel-back]') || this.getFocusable(next)[0];
        window.setTimeout(() => focusTarget?.focus({ preventScroll: true }), this.reducedMotion ? 0 : 310);
      }

      setupLocalization() {
        this.querySelectorAll('[data-desktop-localization]').forEach((details) => {
          const summary = details.querySelector('summary');
          details.addEventListener('toggle', () => {
            summary?.setAttribute('aria-expanded', String(details.open));
            this.syncHeaderChrome();
          });
          details.addEventListener('mouseenter', () => {
            if (this.hoverQuery.matches && this.desktopQuery.matches) details.open = true;
          });
          details.addEventListener('mouseleave', () => {
            if (!this.hoverQuery.matches || !this.desktopQuery.matches) return;
            window.setTimeout(() => {
              if (!details.matches(':hover') && !details.contains(document.activeElement)) details.open = false;
            }, 80);
          });
          details.addEventListener('focusout', () => {
            window.setTimeout(() => {
              if (!details.contains(document.activeElement) && !details.matches(':hover')) details.open = false;
            }, 0);
          });
        });
        this.querySelectorAll('[data-country-search]').forEach((input) => {
          input.addEventListener('input', () => {
            const value = input.value.trim().toLowerCase();
            const form = input.closest('.helix-localization');
            form?.querySelectorAll('[data-country-option]').forEach((option) => {
              option.hidden = value !== '' && !option.dataset.searchValue.includes(value);
            });
          });
        });
      }

      setupPredictiveSearch() {
        this.predictiveInput = this.querySelector('[data-predictive-input]');
        this.predictiveResults = this.querySelector('[data-predictive-results]');
        this.popularSearches = this.querySelector('[data-popular-searches]');
        if (!this.predictiveInput || !this.predictiveResults) return;
        this.predictiveInput.addEventListener('input', () => {
          window.clearTimeout(this.predictiveTimer);
          this.predictiveTimer = window.setTimeout(() => this.loadPredictiveResults(), 180);
        });
      }

      async loadPredictiveResults() {
        const query = this.predictiveInput.value.trim();
        const shouldSearch = query.length >= 2;
        if (this.popularSearches) this.popularSearches.hidden = shouldSearch;
        if (!shouldSearch) {
          this.predictiveController?.abort();
          this.predictiveResults.replaceChildren();
          this.predictiveInput.setAttribute('aria-expanded', 'false');
          return;
        }
        this.predictiveController?.abort();
        this.predictiveController = new AbortController();
        const endpoint = new URL(this.dataset.predictiveUrl, window.location.origin);
        endpoint.searchParams.set('q', query);
        endpoint.searchParams.set('resources[type]', 'product,query,collection,page,article');
        endpoint.searchParams.set('resources[limit]', '6');
        endpoint.searchParams.set('resources[options][unavailable_products]', 'last');
        endpoint.searchParams.set('section_id', this.dataset.predictiveSection);
        try {
          const response = await fetch(endpoint, { signal: this.predictiveController.signal, headers: { Accept: 'text/html' } });
          if (!response.ok) return;
          const html = await response.text();
          const documentFragment = new DOMParser().parseFromString(html, 'text/html');
          const content = documentFragment.querySelector('#HelixPredictiveResults');
          this.predictiveResults.innerHTML = content ? content.innerHTML : '';
          this.predictiveInput.setAttribute('aria-expanded', String(Boolean(content)));
        } catch (error) {
          if (error.name !== 'AbortError') this.predictiveInput.setAttribute('aria-expanded', 'false');
        }
      }

      setupCart() {
        this.addEventListener('submit', (event) => {
          const form = event.target.closest('[data-helix-quick-add]');
          if (!form) return;
          event.preventDefault();
          this.quickAdd(form);
        });
      }

      async quickAdd(form) {
        const button = form.querySelector('button[type="submit"]');
        if (button) button.disabled = true;
        const endpoint = form.action.endsWith('.js') ? form.action : `${form.action}.js`;
        try {
          const response = await fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (!response.ok) return;
          await this.refreshCart();
          const trigger = this.querySelector('[data-overlay-open="cart"]');
          if (trigger && this.overlays.has('cart')) this.openOverlay('cart', trigger);
        } finally {
          if (button) button.disabled = false;
        }
      }

      async refreshCart() {
        if (!this.dataset.cartUrl) return;
        try {
          const response = await fetch(`${this.dataset.cartUrl}.js`, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
          if (!response.ok) return;
          const cart = await response.json();
          this.renderCart(cart);
        } catch (error) {
          return;
        }
      }

      renderCart(cart) {
        this.querySelectorAll('[data-cart-count]').forEach((count) => { count.textContent = cart.item_count; });
        this.querySelectorAll('[data-overlay-open="cart"]').forEach((trigger) => {
          trigger.setAttribute('aria-label', `${this.dataset.cartLabel} (${cart.item_count})`);
        });
        const heading = this.querySelector('[data-cart-heading]');
        if (heading) heading.textContent = `${this.dataset.cartLabel} (${cart.item_count})`;
        const itemsContainer = this.querySelector('[data-cart-items]');
        const empty = this.querySelector('[data-cart-empty]');
        const filled = this.querySelector('[data-cart-filled]');
        if (!itemsContainer || !empty || !filled) return;
        itemsContainer.replaceChildren();
        cart.items.forEach((item) => itemsContainer.append(this.createCartItem(item)));
        const hasItems = cart.item_count > 0;
        itemsContainer.hidden = !hasItems;
        empty.hidden = hasItems;
        filled.hidden = !hasItems;
        const total = filled.querySelector('[data-cart-total]');
        if (total) total.textContent = this.formatMoney(cart.total_price);
      }

      createCartItem(item) {
        const article = document.createElement('article');
        article.className = 'helix-cart-item';
        const mediaLink = document.createElement('a');
        mediaLink.className = 'helix-cart-item__image';
        mediaLink.href = item.url;
        if (item.image) {
          const image = document.createElement('img');
          image.src = item.image;
          image.alt = item.product_title;
          image.width = 84;
          image.height = 84;
          image.loading = 'lazy';
          mediaLink.append(image);
        }
        const content = document.createElement('div');
        const title = document.createElement('a');
        title.href = item.url;
        title.textContent = item.product_title;
        content.append(title);
        if (item.variant_title && item.variant_title !== 'Default Title') {
          const variant = document.createElement('small');
          variant.textContent = item.variant_title;
          content.append(variant);
        }
        const quantity = document.createElement('span');
        quantity.textContent = `${this.dataset.quantityLabel}: ${item.quantity}`;
        content.append(quantity);
        const price = document.createElement('strong');
        price.textContent = this.formatMoney(item.final_line_price);
        content.append(price);
        article.append(mediaLink, content);
        return article;
      }

      formatMoney(cents) {
        try {
          return new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency: this.dataset.currency }).format(cents / 100);
        } catch (error) {
          return `${(cents / 100).toFixed(2)} ${this.dataset.currency}`;
        }
      }

      setupProductCarousels() {
        this.querySelectorAll('[data-mega-previous], [data-mega-next]').forEach((button) => {
          button.addEventListener('click', () => {
            const wrapper = button.closest('.helix-mega__products-wrap');
            const scroller = wrapper?.querySelector('[data-mega-products]');
            if (!scroller) return;
            const direction = button.hasAttribute('data-mega-previous') ? -1 : 1;
            scroller.scrollBy({ left: direction * Math.max(170, scroller.clientWidth * .75), behavior: this.reducedMotion ? 'auto' : 'smooth' });
          });
        });
      }

      requestScrollUpdate() {
        if (this.scrollTicking) return;
        this.scrollTicking = true;
        window.requestAnimationFrame(() => {
          this.updateScrollState();
          this.scrollTicking = false;
        });
      }

      updateScrollState() {
        const current = Math.max(0, window.scrollY);
        if (this.desktopQuery.matches) {
          this.classList.toggle('is-scrolled', this.stickyDesktop && current > 24);
          this.classList.remove('is-mobile-hidden');
        } else if (this.stickyMobile) {
          if (current <= 56) {
            this.classList.remove('is-scrolled', 'is-mobile-hidden');
          } else {
            this.classList.add('is-scrolled');
            if (current > this.lastScroll + 4) this.classList.add('is-mobile-hidden');
            if (current < this.lastScroll - 4) this.classList.remove('is-mobile-hidden');
          }
        } else {
          this.classList.remove('is-scrolled', 'is-mobile-hidden');
        }
        if (Math.abs(current - this.lastScroll) > 4 && this.menuItems.some((item) => item.classList.contains('is-open'))) this.closeMenus();
        this.lastScroll = current;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Helix header",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "transparent_logo", "label": "Logo on transparent header" },
    { "type": "range", "id": "logo_width", "label": "Desktop logo width", "min": 80, "max": 180, "step": 5, "unit": "px", "default": 110 },
    { "type": "range", "id": "mobile_logo_width", "label": "Mobile logo width", "min": 70, "max": 130, "step": 5, "unit": "px", "default": 90 },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "desktop_menu", "label": "Desktop menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu", "info": "Uses the desktop menu when left blank." },
    { "type": "collection", "id": "men_sale_collection", "label": "Men mega menu product collection" },
    { "type": "header", "content": "Header behavior" },
    { "type": "checkbox", "id": "transparent_header", "label": "Transparent header on home page", "default": true },
    { "type": "checkbox", "id": "sticky_desktop", "label": "Sticky desktop header", "default": true },
    { "type": "checkbox", "id": "sticky_mobile", "label": "Show mobile header when scrolling up", "default": true },
    { "type": "header", "content": "Utilities" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show cart", "default": true },
    { "type": "checkbox", "id": "cart_drawer", "label": "Open cart in a drawer", "default": true },
